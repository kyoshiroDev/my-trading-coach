# Modèle de /opt/backups/offsite.env (chmod 600, jamais versionné).
RESTIC_REPOSITORY=b2:<bucket>:mtc
# Généré sur le VPS : openssl rand -base64 32 — à copier dans le gestionnaire de mots de passe.
RESTIC_PASSWORD=
# Clé d'application B2 limitée au bucket (Read and Write).
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
