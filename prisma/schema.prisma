generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String?
  role        Role      @default(USER)
  plan        Plan      @default(FREE)
  trialEndsAt DateTime?
  trialUsed   Boolean   @default(false)

  // ── Reset mot de passe ──────────────────────────────────────────────────
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  // ── Consentement marketing (RGPD Art. 6.1.a) ──────────────────────────────
  // Aucun email marketing/réengagement ne part sans marketingConsent=true.
  // unsubToken : jeton du lien de désinscription (généré à la création, lazy
  // pour les comptes existants au 1er besoin).
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  unsubToken         String?   @unique

  // ── Stripe ──────────────────────────────────────
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripePriceId            String?
  stripeInterval           String? // 'month' | 'year'
  stripeCurrentPeriodEnd   DateTime?
  stripeSubscriptionStatus String? // 'active' | 'trialing' | 'past_due' | 'unpaid' | 'canceled'
  subscriptionCanceledAt   DateTime? // date de résiliation (churn fiable) ; remis à null au réabonnement

  // Compte vitrine en lecture seule (démo landing). Bloque les écritures
  // (DemoReadOnlyGuard) et est exclu de toutes les métriques/crons/emails admin.
  isDemo Boolean @default(false)

  // ── Onboarding ─────────────────────────────────────────────────────────────
  onboardingCompleted Boolean @default(false)
  market              String?
  goal                String?

  // ── Préférences ─────────────────────────────────────────────────────────────
  currency           String  @default("USD")
  currencyRate       Float   @default(1)
  startingCapital    Float   @default(0)
  notificationsEmail Boolean @default(true)
  debriefAutomatic   Boolean @default(true)

  // ── Profil stratégie ─────────────────────────────────────────────────────
  tradingStyle        String?
  tradingStrategy     String[] @default([])
  tradingSessions     String[] @default([])
  tradesPerDayMin     Int?
  tradesPerDayMax     Int?
  strategyDescription String?

  // ── Actifs tradés ────────────────────────────────────────────────────────
  tradingAssets String[] @default([]) // configurés dans les paramètres
  favoriteAsset String? // pré-sélectionné dans la saisie rapide

  // ── Parrainage ambassadeur ────────────────────────────────────────────────
  referralCode String? @unique // code de parrainage unique
  referredBy   String? // code de l'ambassadeur qui a référé cet user

  // ── Acquisition (UTM du lien d'inscription) ──────────────────────────────
  // Capturés à l'inscription (landing → /register → POST /auth/register), normalisés
  // en minuscules. null = aucun UTM (« direct / non renseigné » à l'agrégation admin) :
  // jamais de valeur par défaut. Donnée fonctionnelle, indépendante du bandeau cookies.
  acquisitionSource   String?
  acquisitionMedium   String?
  acquisitionCampaign String?

  // ── Calendrier économique ─────────────────────────────────────────────────
  // Sélection d'annonces du JOUR (rituel de prep). Format : "EventName:Currency".
  // Réinitialisée chaque jour : si pinnedEcoDate ≠ aujourd'hui (Europe/Paris), la
  // lecture renvoie une sélection vide (reset paresseux, sans cron).
  pinnedEcoEvents String[] @default([])
  pinnedEcoDate   String? // YYYY-MM-DD (Europe/Paris) — jour de la sélection

  // ── Discord ──────────────────────────────────────────────────────────────────
  discordId String? @unique

  trades          Trade[]
  setups          Setup[]
  debriefs        WeeklyDebrief[]
  aiUsageLogs     AiUsageLog[]
  tradeSessions   TradeSession[]
  tradingAccounts TradingAccount[]
  dailyRecaps     DailyRecap[]
  dailyActivity   UserDailyActivity[]
  /// Fiches de parsing de broker que cet admin a validees.
  brokerCsvMappings BrokerCsvMapping[]
  emailSends      EmailSend[]
  referrals       ReferralCommission[] @relation("AmbassadorCommissions")
  parrainRewards  ReferralReward[]     @relation("ParrainRewards")
  brokerConnections BrokerConnection[]
  lastSeenAt      DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model ReferralCommission {
  id             String   @id @default(cuid())
  ambassadorId   String
  referredUserId String
  amount         Float
  subscriptionId String
  period         String
  status         String   @default("pending")
  createdAt      DateTime @default(now())

  // Cascade comme les 9 autres relations vers User : sans onDelete, Postgres applique
  // RESTRICT et un ambassadeur porteur d'une commission ne peut PLUS supprimer son
  // compte — la transaction de `archiveAndDelete` echoue, et le front n'en disait rien.
  ambassador User @relation("AmbassadorCommissions", fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, period])
  @@index([ambassadorId])
}

// Parrainage grand public : mois offert au parrain (user normal) pour chaque
// filleul payant. Miroir de ReferralCommission, mais récompense en mois offert
// (crédit Stripe) et non en commission cash. Unicité (filleulId) = 1 seule
// récompense par filleul, jamais cumulée avec la commission ambassadeur.
model ReferralReward {
  id             String   @id @default(cuid())
  parrainId      String
  filleulId      String   @unique
  subscriptionId String
  amountEur      Float    @default(0)
  status         String   @default("PENDING") // PENDING | APPLIED
  createdAt      DateTime @default(now())

  // Idem : un parrain avec un mois offert restait bloque. La trace analytique du depart
  // vit dans DeletedAccount, pas ici.
  parrain User @relation("ParrainRewards", fields: [parrainId], references: [id], onDelete: Cascade)

  @@index([parrainId])
}

/// Provenance d'un trade — d'ou vient la ligne, pas ce qu'elle vaut.
/// Sert a l'affichage (badge) et au diagnostic : un ecart de frais ou de P&L se lit
/// differemment selon qu'il vient d'une saisie, d'un CSV ou du broker.
enum TradeSource {
  /// Saisi a la main dans l'app.
  MANUAL
  /// Import d'un fichier CSV/Excel par l'utilisateur.
  CSV_IMPORT
  /// Synchro live du broker (Trade API) : la seance en cours.
  BROKER_SYNC
  /// Import de l'historique du broker (Reporting API) : les mois passes.
  BROKER_HISTORY
}

model Trade {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset          String
  side           TradeSide
  entry          Float
  exit           Float?
  stopLoss       Float?
  takeProfit     Float?
  pnl            Float?
  commission     Float?
  riskReward     Float?
  quantity       Float?
  capitalEngaged Float?
  // Note d'exécution CALCULÉE — déterministe, zéro IA, indépendante du P&L.
  // Non saisie par l'utilisateur. Dérivée de stop/RR/émotion effective/risque (voir execution-grade.util).
  executionScore Int?             // 0-100, null si < 2 critères applicables (« Non évalué »)
  executionGrade ExecutionGrade?  // dérivé du score (EXCELLENT/BON/MOYEN/MAUVAIS)
  executionMethod ExecutionMethod? // barème ayant produit la note (STOP_BASED / BEHAVIORAL), null si non notée
  // Override optionnel de l'émotion du trade (surtout REVENGE/FEAR dans l'instant).
  // Émotion effective = emotion ?? tradeSession.moodStart ?? null (voir effective-emotion.util).
  emotion        EmotionState?
  setupId        String
  // NoAction (vérif en fin d'instruction) : la suppression d'un user cascade ses
  // trades ET ses setups sans violer la FK. La règle "pas de delete si trades" est
  // portée par SetupsService + ce backstop FK.
  setup          Setup           @relation(fields: [setupId], references: [id], onDelete: NoAction)
  session        TradingSession
  timeframe      String
  notes          String?
  tags           String[]
  sessionId      String?
  tradeSession   TradeSession?   @relation(fields: [sessionId], references: [id])
  accountId      String?
  account        TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  tradedAt       DateTime        @default(now())
  createdAt      DateTime        @default(now())
  /// Provenance de la ligne. `MANUAL` par défaut : c'est le cas des trades existants,
  /// et celui d'une saisie. Les imports la posent explicitement.
  source         TradeSource     @default(MANUAL)
  /// Empreinte d'un trade IMPORTÉ (asset+side+tradedAt+entry+exit+pnl), posée par
  /// `importTrades`. `null` pour les trades saisis à la main : en Postgres, plusieurs
  /// NULL ne violent pas une contrainte d'unique, donc la saisie manuelle n'est pas
  /// contrainte (deux scalps identiques à la même seconde restent possibles).
  /// C'est la déduplication d'import portée par la BASE : la version applicative
  /// (lire puis écrire) laissait un double-clic créer deux fois l'historique.
  importHash     String?

  @@unique([userId, importHash])
  @@index([userId, tradedAt])
  @@index([userId, emotion])
  @@index([userId, setupId])
  @@index([sessionId])
  @@index([accountId])
}

/// Setup de trading défini par l'utilisateur (remplace l'ancien enum SetupType).
/// La description sert aussi de contexte au coach IA.
model Setup {
  id          String   @id @default(cuid())
  userId      String
  title       String // label de la chip, affiché en MAJ côté UI
  color       String // hex, ex "#10b981"
  description String?  @db.Text // sert AUSSI de contexte au coach IA
  sortOrder   Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades      Trade[]

  @@index([userId, archived])
  @@index([userId, sortOrder])
}

model WeeklyDebrief {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber  Int
  year        Int
  startDate   DateTime
  endDate     DateTime
  aiSummary   String
  insights    Json
  objectives  Json
  stats       Json
  generatedAt DateTime @default(now())

  @@unique([userId, weekNumber, year])
  @@index([userId, year, weekNumber])
}

model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String? // null pour les jobs système (traductions news/eco, crons)
  feature      String
  model        String   @default("claude-sonnet-4-6") // vrai modèle appelé → ventilation Haiku/Sonnet
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([feature])
  @@index([model])
}

// ── V2 Session Mode ─────────────────────────────────────────────────────────

model TradeSession {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt          DateTime        @default(now())
  endedAt            DateTime?
  moodStart          MoodState?
  moodEnd            MoodState?
  totalPnl           Float?
  totalTrades        Int             @default(0)
  winRate            Float?
  status             SessionStatus   @default(ACTIVE)
  notes              String?
  reflectionNote     String?
  reflectionQuestion String?
  planNote           String?
  marketContext      String?
  maxDrawdown        Float?
  bestTradePnl       Float?
  bestTradeAsset     String?
  accountId          String?
  account            TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  trades             Trade[]
  createdAt          DateTime        @default(now())

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([accountId])
}

// ── Multi-comptes (prop firms + perso) ──────────────────────────────────────
model TradingAccount {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String // "Apex 50k #1"
  broker          String? // prop firm / courtier
  type            AccountType    @default(PERSONAL)
  status          AccountStatus  @default(ACTIVE)
  accountSize     Float?
  currency        String         @default("USD")
  // Règles prop firm (saisies par l'user, propres à sa firm/plan) :
  startingBalance Float? // base du solde (défaut = accountSize si null)
  profitTarget    Float? // objectif (eval) / objectif payout (funded), en $
  maxDrawdown     Float? // montant du drawdown autorisé, en $
  drawdownType    DrawdownType   @default(STATIC)
  trades          Trade[]
  tradeSessions   TradeSession[]
  brokerConnections BrokerConnection[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, status])
}

/// Connexion API d'un broker, portée par UN `TradingAccount`.
/// Un compte = une connexion : chaque prop firm fournit ses propres identifiants
/// Tradovate, un user Apex + Lucid fait donc deux connexions distinctes. Jamais au
/// niveau `User`, jamais partagée entre comptes.
/// Les secrets (tokens OAuth, clés API) sont CHIFFRÉS (AES-256-GCM, `token-cipher.util`)
/// et ne sortent jamais de l'API : aucune route ne renvoie les colonnes `*Enc`.
model BrokerConnection {
  id                    String                 @id @default(cuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  account               TradingAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider              BrokerProvider
  status                BrokerConnectionStatus @default(CONNECTED)
  accessTokenEnc        String
  refreshTokenEnc       String?
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime?
  /// Identifiant du user côté broker (Tradovate userId), pour le diagnostic.
  externalUserId        String?
  /// Compte broker synchronisé vers ce TradingAccount (un login Tradovate peut porter
  /// plusieurs comptes : il faut en choisir un).
  externalAccountId     String?
  externalAccountName   String?
  /// Hôte du compte choisi : 'live' ou 'demo' (les comptes prop firm sont simulés).
  externalEnv           String?
  /// Hôtes Tradovate du login (`apiHosts` de `renewAccessToken`) : { live, demo, reportingLive,
  /// reportingDemo, … }, hôtes nus. L'hôte `demo` varie par organisation (prop firm) et peut
  /// changer : REST, WebSocket et reporting s'y routent, repli sur les hôtes historiques si null.
  apiHosts              Json?
  /// Date de la dernière lecture de `apiHosts` : relu dès qu'il a plus de 30 min.
  apiHostsAt            DateTime?
  /// Comptes vus à la connexion : [{ id, name, env }]. Sert au choix quand il y en a plusieurs.
  availableAccounts     Json?
  lastSyncAt            DateTime?
  /// Dernière erreur de synchro, en clair et lisible par l'utilisateur (jamais une stack).
  lastSyncError         String?
  /// Cumul des trades créés par la synchro (hors doublons).
  tradesImported        Int                    @default(0)
  /// Date du premier import RÉUSSI de tout l'historique du compte (Reporting API), remonté
  /// jusqu'à sa création. Tant que c'est `null`, la prochaine synchro le tente — y compris celle
  /// du cron : une connexion créée avant cette feature, ou dont l'import initial a échoué,
  /// récupère donc son passé sans que l'utilisateur ait quoi que ce soit à faire.
  historyImportedAt     DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([accountId, provider])
  @@index([userId])
}

model DailyRecap {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  tradesCount     Int      @default(0)
  pnl             Float    @default(0)
  winRate         Float    @default(0)
  dominantEmotion String?
  aiOneLiner      String?
  generatedAt     DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model EcoCalendarCache {
  id          String   @id @default(cuid())
  date        DateTime
  rawData     Json
  aiAnalysis  Json
  generatedAt DateTime @default(now())

  @@unique([date])
  @@index([date])
}

/// Analyse IA du calendrier éco mutualisée par (date, signature d'actifs).
/// 1 appel IA par signature partagé entre tous les users → coût O(actifs) au lieu de O(users).
/// Fiche de parsing d'un broker, deduite une fois puis reutilisee pour tous les users.
///
/// Remplace l'ecriture d'un parseur TypeScript par broker : le modele deduit la
/// correspondance des colonnes sur 20 lignes, un admin la valide sur un apercu, et elle vit
/// ICI plutot que dans le code. Consequence voulue : ajouter un broker ne demande plus de
/// build ni de deploiement, donc peut se faire depuis un telephone quand un utilisateur
/// signale que son export ne passe pas.
///
/// Ne contient AUCUNE donnee d'utilisateur : uniquement des index de colonnes et des regles
/// de format. L'echantillon qui a servi a deduire la fiche n'est pas conserve.
model BrokerCsvMapping {
  id String @id @default(cuid())

  /// Empreinte de l'en-tete normalise (minuscules, espaces reduits) : c'est la cle de
  /// reconnaissance. Exacte a dessein — si le broker ajoute une colonne, la fiche ne
  /// correspond plus et l'import retombe sur « inconnu ». Mieux vaut ne pas reconnaitre
  /// que reconnaitre de travers et decaler toutes les colonnes.
  headerHash String @unique

  /// Nom lisible donne par l'admin (« NinjaTrader 8 », « Quantower »...).
  brokerName String
  /// En-tete tel quel, pour diagnostiquer une fiche qui ne matche plus.
  headerSample String @db.Text
  /// La fiche elle-meme, au format de `CsvMapping` (csv-mapping.ts).
  mappingJson String @db.Text

  /// Part des lignes de l'echantillon dont le signe du P&L confirmait le sens, au moment de
  /// la validation. Trace de la confiance accordee, pour pouvoir re-examiner plus tard.
  pnlConfidence Float
  /// Admin qui a valide : une fiche fausse corrompt les trades de tous les users du broker.
  validatedById String
  validatedBy   User   @relation(fields: [validatedById], references: [id], onDelete: Restrict)

  /// Desactivable sans suppression : on garde la trace si une fiche s'avere mauvaise.
  enabled Boolean @default(true)
  /// Compteur d'usage : sert a reperer les fiches qui portent le plus d'imports.
  usageCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([validatedById])
}

model EcoAnalysisCache {
  id           String   @id @default(cuid())
  date         String // YYYY-MM-DD Paris
  assetsKey    String // signature normalisée des actifs
  analysisJson String   @db.Text
  createdAt    DateTime @default(now())

  @@unique([date, assetsKey])
  @@index([date])
}

enum MoodState {
  CONFIDENT
  FOCUSED
  NEUTRAL
  TIRED
  STRESSED
}

enum SessionStatus {
  ACTIVE
  CLOSED
}

// ── Multi-comptes (prop firms + perso) ──────────────────────────────────────
enum AccountType {
  EVALUATION
  FUNDED
  PERSONAL
  DEMO
}

enum AccountStatus {
  ACTIVE
  PASSED
  FAILED
  ARCHIVED
}

enum DrawdownType {
  STATIC
  TRAILING
}

// ── Idempotence webhooks Stripe ─────────────────────────────────────────────
model StripeEvent {
  id          String   @id // Stripe event ID (evt_...)
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

enum Role {
  ADMIN
  USER
  BETA_TESTER
  AMBASSADOR
}

enum Plan {
  FREE
  PREMIUM
}

enum TradeSide {
  LONG
  SHORT
}

enum EmotionState {
  CONFIDENT
  STRESSED
  REVENGE
  FEAR
  FOCUSED
  NEUTRAL
}

/// Note d'exécution calculée d'un trade — dérivée du score 0-100, jamais saisie.
enum ExecutionGrade {
  EXCELLENT
  BON
  MOYEN
  MAUVAIS
}

/// Barème ayant produit la note. STOP_BASED = trade avec stop (4 critères intrinsèques) ;
/// BEHAVIORAL = trade sans stop (3 critères comportementaux, relatifs à l'historique). Non comparables.
enum ExecutionMethod {
  STOP_BASED
  BEHAVIORAL
}

enum TradingSession {
  LONDON
  NEW_YORK
  ASIAN
}

/// Brokers synchronisés par API (lecture seule). Binance / Bybit viendront s'y ajouter.
enum BrokerProvider {
  TRADOVATE
}

enum BrokerConnectionStatus {
  CONNECTED
  /// Jeton expiré ou révoqué côté broker : l'utilisateur doit refaire le consentement.
  NEEDS_RECONNECT
}

model EcoEvent {
  id         String   @id @default(cuid())
  date       String
  time       String
  name       String
  country    String
  currency   String
  impact     String
  actual     Float?
  estimate   Float?
  previous   Float?
  isReleased Boolean  @default(false)
  unit       String?
  nameFr     String? // libellé traduit une seule fois
  fetchedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([date, name, currency])
  @@index([date])
  @@index([date, isReleased])
}

model MarketNews {
  id            String   @id @default(cuid())
  url           String   @unique // clé de dédup (un article = une URL)
  symbol        String
  title         String // titre original
  titleFr       String? // traduit une seule fois
  text          String?  @db.Text
  textFr        String?  @db.Text
  sentiment     String? // bull | bear | neutral
  image         String?
  site          String?
  publishedDate DateTime
  translated     Boolean  @default(false) // titre traduit (eager). Le texte est traduit paresseusement → textTranslated
  textTranslated Boolean  @default(false) // corps de l'article traduit à la 1re ouverture, puis persisté
  fetchedAt     DateTime @default(now())

  @@index([symbol, publishedDate])
  @@index([translated])
}

/// Glossaire global des libellés d'événements éco : chaque libellé EN traduit une seule fois à vie.
model EcoLabelTranslation {
  nameEn    String   @id
  nameFr    String
  createdAt DateTime @default(now())
}

/// Log unitaire d'envoi d'email (moteur de campagnes). Source de vérité de
/// l'anti-doublon (oneShot), du plafond de fréquence marketing et du compteur
/// "déjà contacté" de l'admin. 1 ligne = 1 email envoyé à 1 user.
model EmailSend {
  id          String   @id @default(cuid())
  campaignKey String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String // 'transactional' | 'marketing'
  sentAt      DateTime @default(now())

  @@index([campaignKey, userId])
  @@index([userId, sentAt])
}

model EmailCampaignLog {
  id           String   @id @default(cuid())
  type         String
  subject      String?
  sentBy       String
  targetCount  Int
  successCount Int      @default(0)
  errorCount   Int      @default(0)
  sentAt       DateTime @default(now())

  @@index([type, sentAt])
}

// Historique quotidien des métriques clés (1 ligne/jour) → courbes d'évolution admin.
model MetricsSnapshot {
  id           String   @id @default(cuid())
  date         String   @unique // YYYY-MM-DD Paris (1 snapshot/jour)
  mrr          Int
  arr          Int
  totalUsers   Int
  freeUsers    Int
  starterUsers Int
  premiumUsers Int
  trials       Int
  newThisDay   Int // inscriptions du jour (24h glissantes)
  activeUsers  Int // users avec ≥1 trade sur 7 jours
  betaTesters  Int
  ambassadors  Int
  createdAt    DateTime @default(now())

  @@index([date])
}

/// Un jour d'activité par utilisateur (≥1 requête authentifiée dans la journée).
/// Alimente la heatmap « Connexions par jour » de la fiche admin. RGPD : userId + date
/// seulement, suppression en cascade avec le compte.
model UserDailyActivity {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  @@unique([userId, date])
  @@index([userId, date])
}

/// Trace analytique d'un compte supprimé (RGPD). Identité (name/email)
/// conservée 90 jours puis anonymisée par cron ; les champs analytiques restent.
model DeletedAccount {
  id           String    @id @default(cuid())
  name         String? // anonymisé après 90 j
  email        String? // anonymisé après 90 j
  signedUpAt   DateTime
  deletedAt    DateTime  @default(now())
  lifetimeDays Int
  plan         Plan
  hadTraded    Boolean
  tradesCount  Int
  referredBy   String?
  deletedBy    String // "self" | "admin"
  reason       String?
  anonymizedAt DateTime?

  @@index([deletedAt])
  @@index([anonymizedAt])
}

/// Cache quotidien du coût RÉEL facturé par Anthropic (Cost API). Source autoritative.
model AnthropicCostDaily {
  date      String // 'YYYY-MM-DD' (bucket jour, UTC) tel que renvoyé par la Cost API
  model     String // modèle parsé depuis `description` (ex 'claude-haiku-4-5'), 'other' sinon
  amountUsd Float
  updatedAt DateTime @updatedAt

  @@id([date, model])
}

/// Mesure d'audience de la landing SANS cookie (exemption CNIL) : uniquement des compteurs
/// agrégés par jour (Europe/Paris), page et source (+ medium, campagne). Aucune IP, aucun identifiant, aucun
/// lien avec un compte. `source` = utm_source, sinon hôte du site d'origine, sinon '' (direct).
model LandingVisitDaily {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  path      String
  source    String   @default("")
  /// utm_medium (ou « referral » en plan B), '' si absent.
  medium    String   @default("")
  /// utm_campaign, '' si absent.
  campaign  String   @default("")
  /// Pages vues.
  pageviews Int      @default(0)
  /// Visites = 1re page vue d'une session d'onglet (sessionStorage).
  visits    Int      @default(0)

  // L'unique (date en tête) sert aussi d'index pour les lectures par période.
  @@unique([date, path, source, medium, campaign])
}
