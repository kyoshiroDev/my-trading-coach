{
  "name": "app-mytradingcoach",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "mtc",
  "sourceRoot": "apps/app-mytradingcoach/src",
  "tags": ["type:app", "scope:front"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "development",
      "options": {
        "outputPath": "dist/apps/app-mytradingcoach",
        "browser": "apps/app-mytradingcoach/src/main.ts",
        "tsConfig": "apps/app-mytradingcoach/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/app-mytradingcoach/public"
          }
        ],
        "styles": ["apps/app-mytradingcoach/src/styles.css"]
      },
      "configurations": {
        "local": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/app-mytradingcoach/src/environments/environment.ts",
              "with": "apps/app-mytradingcoach/src/environments/environment.production.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "450kb",
              "maximumError": "500kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "28kb",
              "maximumError": "34kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": true
            },
            "fonts": false
          }
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "apps/app-mytradingcoach/src/environments/environment.ts",
              "with": "apps/app-mytradingcoach/src/environments/environment.dev.ts"
            }
          ],
          "outputHashing": "all",
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "beta": {
          "fileReplacements": [
            {
              "replace": "apps/app-mytradingcoach/src/environments/environment.ts",
              "with": "apps/app-mytradingcoach/src/environments/environment.beta.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "450kb",
              "maximumError": "500kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "28kb",
              "maximumError": "34kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": true
            },
            "fonts": false
          }
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "local",
      "options": {
        "buildTarget": "app-mytradingcoach:build:local"
      },
      "configurations": {
        "local": {
          "buildTarget": "app-mytradingcoach:build:local"
        },
        "production": {
          "buildTarget": "app-mytradingcoach:build:production"
        },
        "development": {
          "buildTarget": "app-mytradingcoach:build:development"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/app-mytradingcoach",
        "parallel": false,
        "commands": [
          "tsc --noEmit -p tsconfig.app.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ]
      }
    },
    "test": {
      "options": {
        "config": "./vitest.config.mts"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "app-mytradingcoach:build",
        "port": 4200,
        "staticFilePath": "dist/apps/app-mytradingcoach/browser",
        "spa": true
      }
    }
  }
}
