---
import { FEATURES, APP_URL } from '../config';
// Prix : source unique @mtc/shared (cf. .claude/agents/plans.md).
import {
  FOUNDER_OFFER,
  FOUNDER_REFUND_DAYS,
  PREMIUM_ANNUAL_SAVINGS_EUR,
  PLAN_BENEFITS,
  PREMIUM_PRICE_EUR,
} from '@mtc/shared';

// Cartes Gratuit / Fondateur / Premium : listes courtes PARTAGÉES avec l'app et les e-mails
// (PLAN_BENEFITS, @mtc/shared). Comptes illimités : déjà dans l'encart « comptes » des cartes
// quand le multi-comptes est publié, donc jamais répété dans la liste.
const freeBenefits = PLAN_BENEFITS.free.map((b) => b.text);
const premiumBenefits = PLAN_BENEFITS.premium.filter((b) => b.id !== 'accounts').map((b) => b.text);
// Bloc « Ce que Premium ajoute au Gratuit » : le détail. Chaque ligne = une fonction LIVRÉE et
// RÉSERVÉE au Premium (gating vérifié le 2026-10-19, cf. plans.md). Alertes et anti-tilt : synchro
// Tradovate en direct, donc compte Tradovate connecté, app ouverte ou en notification pendant la
// séance (veille serveur #770, notifications activées).
const premiumDetails = [
  ...(FEATURES.multiAccounts ? ['Comptes de trading illimités, chacun avec les règles de sa prop firm'] : []),
  'Alertes prop firm en direct, app ouverte ou en notification pendant ta séance (compte Tradovate connecté) : perte du jour, drawdown, consistency, objectif atteint, payout possible',
  'Alertes sonores et notifications pendant ta séance',
  'Anti-tilt en direct, app ouverte ou en notification pendant ta séance (compte Tradovate connecté) : reprise de position après une perte, taille qui grossit, surtrading',
  'Débrief de ta semaine rédigé par le coach IA, chaque dimanche où tu as tradé, en PDF',
  'IA Insights : l’analyse de tes patterns, à la demande',
  'Chat avec le coach IA',
  'Récap du jour par e-mail à 17 h 30, nourri par tes séances suivies en direct',
  'Analyses avancées : par setup, par heure (heatmap), drawdown détaillé',
  'Score trader /100 sur 5 axes',
  'Import IA des brokers non reconnus : ton fichier lu tel quel',
];
// Offre fondateur ouverte AU BUILD (src/lib/founder-build.ts) : carte et note rendues dans le HTML,
// place réservée, plus aucun saut de mise en page quand l'API répond. Fermée au build : gabarits
// <template> inertes comme avant (insérés si l'offre ouvre ensuite). Même balisage dans les deux
// cas : seul l'élément qui l'enveloppe change (`display: contents` quand il est rendu).
const { founderOpen = false } = Astro.props;
const FounderWrap = founderOpen ? 'div' : 'template';
---

<section class:list={['pricing', { 'has-founder': founderOpen }]} id="pricing">
  <div class="wrap-wide">
    <div class="reveal head">
      <span class="sec-label">Tarifs</span>
      <h2>Simple. <em>Transparent.</em></h2>
      <p class="sec-sub">Gratuit pour vivre le compagnon au quotidien, trades illimités inclus. Premium pour la puissance IA personnelle. Premium mensuel à {PREMIUM_PRICE_EUR.monthly} € : 1 mois offert, aucun prélèvement avant la fin.</p>
    </div>
    <div class="plus-box reveal" aria-labelledby="plus-title">
      <div id="plus-title" class="plus-title">Ce que Premium ajoute au Gratuit</div>
      <ul class="plus-list">
        {premiumDetails.map((k) => <li>{k}</li>)}
      </ul>
    </div>
    <div class="price-grid reveal delay-1">

      <!-- FREE -->
      <div class="price-card">
        <div class="price-name">Gratuit</div>
        <div class="price-amt">
          <span class="price-amt-num">0</span>
          <span class="price-amt-cur">€</span>
        </div>
        <div class="price-period">pour toujours · aucune CB requise</div>
        {FEATURES.multiAccounts && (
          <div class="price-accts">
            <span class="acct-n">1</span>
            <span class="acct-t">compte de trading + ses règles prop firm</span>
          </div>
        )}
        <div class="price-divider"></div>
        <ul class="price-feats">
          {freeBenefits.map((f) => <li>{f}</li>)}
        </ul>
        <a href={`${APP_URL}/register`} class="price-cta ghost" data-cta="free" data-ga-event="cta_signup" data-ga-place="pricing-free">Commencer gratuitement</a>
      </div>

      {/* FONDATEUR (#525). Ouverte au build : carte rendue (`.founder-slot`), retirée par le script
           si l'API dit qu'elle ne vend plus ou ne répond pas. Fermée au build : gabarit inerte,
           inséré seulement si l'offre vend ; sans JS, offre fermée, épuisée ou API injoignable →
           2 cartes, Premium « Recommandé », aucun texte de l'offre dans le HTML. Mobile : prix,
           bouton, PUIS fonctionnalités (ordre CSS), et l'arrivée sur #pricing s'arrête ici. */}
      <FounderWrap data-founder-tpl={founderOpen ? undefined : ''} class={founderOpen ? 'founder-slot' : undefined}>
      <div class="price-card feat with-badge is-founder" id="fondateur" data-founder-card>
        <div class="price-pop">Réservé aux {FOUNDER_OFFER.seats} premiers</div>
        <div class="price-name">Fondateur</div>
        <div class="price-amt">
          <span class="price-amt-num">{FOUNDER_OFFER.priceMonthlyEur}</span>
          <span class="price-amt-cur">€</span>
          <span class="price-amt-per">/mois</span>
        </div>
        <div class="price-period">ou {FOUNDER_OFFER.priceAnnualEur} €/an · au lieu de {PREMIUM_PRICE_EUR.monthly} €/mois</div>
        <ul class="founder-promises">
          <li>🔒 Prix bloqué à vie tant que ton abonnement reste actif</li>
          <li>Satisfait ou remboursé {FOUNDER_REFUND_DAYS} jours</li>
        </ul>
        {/* Compteur : place réservée (masqué, pas retiré) jusqu'au vrai chiffre de l'API. Libellé
            partagé founderSeatsLabel (« 200 places disponibles », « Plus que 154 places sur 200 »). */}
        <div class="founder-seats is-pending">
          <div class="founder-seats-text"><strong data-founder-left>&nbsp;</strong></div>
          <span class="founder-seats-bar" aria-hidden="true"><span class="founder-seats-fill"></span></span>
        </div>
        {FEATURES.multiAccounts && (
          <div class="price-accts">
            <span class="acct-n">∞</span>
            <span class="acct-t">comptes illimités, chacun avec ses règles prop firm</span>
          </div>
        )}
        <div class="price-divider"></div>
        <div class="price-plus-lead">Tout Premium <em>inclus :</em></div>
        <ul class="price-feats">
          {premiumBenefits.map((f) => <li>{f}</li>)}
        </ul>
        <a href={`${APP_URL}/register?plan=founder&cta=carte`} class="price-cta prim" data-founder-cta data-cta="founder" data-ga-event="cta_founder" data-ga-place="pricing">
          <span class="cta-main">Devenir fondateur →</span>
          <span class="cta-sub-text">Paiement immédiat · sans essai</span>
        </a>
      </div>
      </FounderWrap>

      <!-- PREMIUM -->
      <div class="price-card feat with-badge is-premium">
        <div class="price-pop">⭐ Recommandé</div>
        <div class="price-name">Premium</div>
        <div class="price-amt">
          <span class="price-amt-num">{PREMIUM_PRICE_EUR.monthly}</span>
          <span class="price-amt-cur">€</span>
          <span class="price-amt-per">/mois</span>
        </div>
        <div class="price-period">ou {PREMIUM_PRICE_EUR.annual} €/an, tu économises {PREMIUM_ANNUAL_SAVINGS_EUR} €</div>
        {FEATURES.multiAccounts && (
          <div class="price-accts">
            <span class="acct-n">∞</span>
            <span class="acct-t">comptes illimités, chacun avec ses règles prop firm</span>
          </div>
        )}
        <div class="price-divider"></div>
        <div class="price-plus-lead">Tout le Gratuit, <em>plus :</em></div>
        <ul class="price-feats">
          {premiumBenefits.map((f) => <li>{f}</li>)}
        </ul>
        <a href={`${APP_URL}/register?plan=premium`} class="price-cta prim" data-cta="premium" data-ga-event="cta_trial" data-ga-place="pricing">
          <span class="cta-main">Essayer Premium · 1 mois offert →</span>
          <span class="cta-sub-text">🔥 Carte requise · annulable en un clic</span>
        </a>
      </div>

    </div>
    <FounderWrap data-founder-note-tpl={founderOpen ? undefined : ''} class={founderOpen ? 'founder-slot' : undefined}>
      <p class="founder-note" data-founder-note>
        Le tarif fondateur n'a pas d'essai : le plan Gratuit sert d'essai. L'essai de 30 jours reste
        sur le Premium à {PREMIUM_PRICE_EUR.monthly} €/mois.
      </p>
    </FounderWrap>
    {founderOpen && (
      /* Arrivée sur #pricing (lien de la pub) ou #fondateur en mobile : la page s'arrête sur la
         carte Fondateur, prix et bouton à l'écran, au lieu du titre de la section (2 écrans plus
         haut). Script inline : il s'exécute pendant la lecture du HTML, avant le 1er affichage.
         Le contenu au-dessus peut encore grandir (polices, bandeau de l'offre) : la carte est
         recalée à chaque étape du chargement, jusqu'au premier geste du visiteur. */
      <script is:inline>
        (function () {
          try {
            var card = document.getElementById('fondateur');
            var mobile = window.matchMedia('(max-width: 1024px)');
            var stopped = false;
            var until = 0;
            var arrival = function () {
              return location.hash === '#pricing' || location.hash === '#fondateur';
            };
            var align = function () {
              if (stopped || !card || !card.isConnected || Date.now() > until) return;
              // Nav fixe (60 px) + bandeau de l'offre (32 px) s'il est affiché + badge de la carte.
              var offset = 60 + (document.documentElement.classList.contains('has-offer-bar') ? 32 : 0) + 22;
              var y = Math.max(0, Math.round(card.getBoundingClientRect().top + window.scrollY - offset));
              if (Math.abs(window.scrollY - y) > 1) window.scrollTo({ top: y, behavior: 'instant' });
            };
            var start = function () {
              if (!card || !mobile.matches || !arrival()) return;
              stopped = false;
              until = Date.now() + 10000;
              // Affichée tout de suite, sans fondu : ni IntersectionObserver (script de module, plus
              // tardif) ni transition de 0,65 s avant que le bouton soit cliquable.
              var reveal = card.closest('.reveal');
              if (reveal) reveal.classList.add('vis', 'vis-now');
              align();
            };
            ['touchstart', 'wheel', 'keydown', 'pointerdown'].forEach(function (ev) {
              window.addEventListener(ev, function () { stopped = true; }, { passive: true, capture: true });
            });
            start();
            document.addEventListener('DOMContentLoaded', align);
            window.addEventListener('load', align);
            if (document.fonts && document.fonts.ready) document.fonts.ready.then(align);
            if (window.ResizeObserver) new ResizeObserver(align).observe(document.body || document.documentElement);
            new MutationObserver(align).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
            // Le navigateur refait son propre saut vers #pricing en fin de chargement : tout
            // défilement qui ne vient pas d'un geste du visiteur (toucher, molette, clavier) est
            // corrigé. Le nôtre ne relance rien (déjà à la bonne position).
            window.addEventListener('scroll', function () { requestAnimationFrame(align); }, { passive: true });
            // Lien interne vers #pricing (bandeau, FAQ) : même arrêt sur la carte.
            window.addEventListener('hashchange', function () { requestAnimationFrame(start); });
          } catch (e) {}
        })();
      </script>
    )}
    <div class="pricing-guarantee reveal">
      <div class="guarantee-item">✓ Annulation en un clic</div>
      <div class="guarantee-item">✓ Données exportables</div>
      <div class="guarantee-item">✓ Support Discord direct</div>
      <div class="guarantee-item">✓ Hébergé en France 🇫🇷</div>
    </div>
  </div>
</section>

<script>
  import { captureCtaFromUrl } from '../lib/founder-offer';
  import { initFounderPricing } from '../lib/founder-pricing';

  captureCtaFromUrl();

  // Carte Fondateur : insérée depuis son <template> seulement si l'offre vend, avec le VRAI
  // compteur ; retirée sinon (mécanisme partagé avec /prop-firm, src/lib/founder-pricing.ts). Le
  // changement se fait au chargement et la section est très bas dans la page : aucun décalage
  // visible (CLS).
  initFounderPricing(document.getElementById('pricing'));
</script>

<style>
  .pricing { padding: 80px 5%; }
  /* Menu « Tarifs » (/#pricing) : le titre ne passe pas sous la barre fixe (60 px). */
  #pricing { scroll-margin-top: 64px; }

  /* Bloc « Ce que Premium ajoute » : lisible d'un coup d'œil, au-dessus des prix */
  .plus-box {
    max-width: 760px;
    margin: 32px auto 0;
    padding: 18px 22px;
    border: 1px solid rgba(59,130,246,.35);
    border-radius: 14px;
    background: rgba(59,130,246,.06);
  }
  .plus-title {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--blue2);
    margin-bottom: 10px;
  }
  .plus-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 20px;
  }
  .plus-list li {
    font-size: 13.5px;
    color: var(--txt);
    line-height: 1.45;
    display: flex;
    gap: 8px;
  }
  .plus-list li::before { content: '+'; color: var(--blue2); font-weight: 700; flex-shrink: 0; }

  .price-plus-lead {
    font-size: 13px;
    font-weight: 600;
    color: var(--txt);
    margin-bottom: 10px;
  }
  .price-plus-lead em { font-style: normal; color: var(--blue2); }
  .wrap-wide { max-width: 1200px; margin: 0 auto; }
  .head { text-align: center; max-width: 640px; margin: 0 auto; }
  .delay-1 { transition-delay: .1s; }
  /* Arrivée directe sur la carte Fondateur (script d'arrivée) : pas de fondu. */
  .reveal.vis-now { transition: none; }
  /* Carte recommandée : place pour le badge « Recommandé » */
  .price-card.with-badge { padding-top: 44px; }
  .price-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 760px;
    margin: 48px auto 0;
  }

  .price-card {
    background: var(--card);
    border: 1px solid var(--b);
    border-radius: 16px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
  }

  .price-card.feat {
    border-color: rgba(59,130,246,.5);
    background: linear-gradient(160deg, rgba(59,130,246,.1), rgba(139,92,246,.07));
    box-shadow: 0 0 40px rgba(59,130,246,.12), inset 0 1px 0 rgba(255,255,255,.06);
    position: relative;
  }

  .price-pop {
    position: absolute;
    top: -14px; left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(90deg, var(--blue), #6366f1);
    color: white;
    font-size: 11px;
    font-family: var(--mono);
    font-weight: 700;
    padding: 5px 18px;
    border-radius: 100px;
    letter-spacing: .6px;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(59,130,246,.4);
  }

  .cta-main { display: block; font-size: 14px; font-weight: 600; }
  .cta-sub-text {
    display: block;
    font-size: 11px;
    font-weight: 400;
    opacity: .85;
    margin-top: 3px;
    font-family: var(--mono);
    letter-spacing: .3px;
  }

  .price-name {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--txt3);
    margin-bottom: 12px;
    text-align: center;
  }
  .price-card.feat .price-name { color: var(--blue2); }

  .price-amt {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 4px;
    justify-content: center;
  }

  .price-amt-num { font-family: var(--disp); font-size: 56px; font-weight: 800; letter-spacing: -2px; color: var(--txt); }
  .price-amt-cur { font-family: var(--disp); font-size: 22px; font-weight: 600; color: var(--txt2); }
  .price-amt-per { font-size: 14px; color: var(--txt3); }

  .price-period {
    font-size: 12px;
    color: var(--txt3);
    font-family: var(--mono);
    text-align: center;
  }

  .price-accts {
    margin: 16px 0 0;
    padding: 12px 14px;
    border-radius: 11px;
    background: rgba(59,130,246,.12);
    border: 1px solid var(--b);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .acct-n { font-family: var(--disp); font-weight: 700; font-size: 20px; color: var(--blue2); }
  .acct-t { font-size: 12.5px; color: var(--txt); line-height: 1.35; }

  .price-divider { height: 1px; background: var(--b); margin: 20px 0; }

  .price-feats {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-bottom: 24px;
    flex: 1;
  }

  .price-feats li {
    font-size: 13px;
    color: var(--txt2);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.5;
  }
  .price-feats li::before { content: '✓'; color: var(--green); flex-shrink: 0; font-weight: 600; margin-top: 1px; }

  .price-cta {
    display: block;
    width: 100%;
    padding: 12px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 600;
    font-family: var(--disp);
    text-align: center;
    text-decoration: none;
    transition: all .2s;
    cursor: pointer;
    border: none;
  }
  .price-cta.prim { background: linear-gradient(90deg, var(--blue), #6366f1); color: white; box-shadow: 0 0 28px rgba(59,130,246,.4); }
  .price-cta.prim:hover { transform: translateY(-1px); box-shadow: 0 0 36px rgba(59,130,246,.5); }
  .price-cta.ghost { background: transparent; color: var(--txt2); border: 1px solid var(--b2); }
  .price-cta.ghost:hover { color: var(--txt); border-color: var(--blue); background: rgba(59,130,246,.05); }

  .pricing-guarantee {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--b);
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }
  .guarantee-item { font-size: 12px; font-family: var(--mono); color: var(--txt3); }

  /* ── Offre fondateur : 3 cartes Gratuit · Fondateur · Premium ── */
  .has-founder .price-grid { grid-template-columns: repeat(3, 1fr); max-width: 1140px; }
  /* Premium perd sa mise en avant au profit de la carte Fondateur. */
  .has-founder .is-premium {
    border-color: var(--b);
    background: var(--card);
    box-shadow: none;
    padding-top: 36px;
  }
  .has-founder .is-premium .price-pop { display: none; }
  .has-founder .is-premium .price-name { color: var(--txt3); }
  .founder-promises {
    list-style: none;
    margin: 14px 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: center;
    font-size: 12.5px;
    color: var(--txt);
  }
  .founder-seats { margin-top: 14px; }
  /* Place gardée tant que le vrai compteur n'est pas arrivé : rien ne bouge quand il s'affiche. */
  .founder-seats.is-pending { visibility: hidden; }
  /* Carte rendue au build : l'enveloppe ne compte pas dans la grille. */
  .founder-slot { display: contents; }
  /* Ancre #fondateur (bouton du Hero) : sous la Nav (60 px) + le badge de la carte, et sous le
     bandeau de l'offre quand il est là (son scroll-padding-top de 92 px s'ajoute). */
  .is-founder { scroll-margin-top: 82px; }
  :global(html.has-offer-bar) .is-founder { scroll-margin-top: 22px; }
  .founder-seats-text {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--txt2);
    text-align: center;
    margin-bottom: 6px;
  }
  .founder-seats-text strong { color: var(--txt); }
  .founder-seats-bar {
    display: block;
    height: 6px;
    border-radius: 100px;
    background: rgba(255,255,255,.08);
    overflow: hidden;
  }
  .founder-seats-fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--blue), #6366f1);
    transform: scaleX(0);
    transform-origin: left;
  }
  .founder-note {
    max-width: 760px;
    margin: 16px auto 0;
    text-align: center;
    font-size: 12px;
    color: var(--txt3);
  }

  @media (max-width: 1024px) {
    .has-founder .price-grid { grid-template-columns: 1fr; max-width: 480px; }
    /* Empilées : Fondateur en premier. */
    .has-founder .is-founder { order: -1; }
    /* Carte Fondateur empilée : prix, bouton, PUIS ce qu'elle contient. Arrivé de la pub, le
       visiteur doit voir le prix et le bouton sans faire défiler. */
    .is-founder .price-cta { order: 1; margin-top: 18px; }
    .is-founder .price-accts,
    .is-founder .price-divider,
    .is-founder .price-plus-lead,
    .is-founder .price-feats { order: 2; }
    .is-founder .price-feats { margin-bottom: 0; }
  }
  @media (max-width: 760px) {
    .price-grid { grid-template-columns: 1fr; gap: 20px; max-width: 480px; }
    .plus-box { max-width: 480px; padding: 16px; }
    .plus-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .price-card { padding: 24px 16px; }
  }
</style>
