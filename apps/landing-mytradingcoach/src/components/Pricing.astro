---
import { FEATURES, APP_URL } from '../config';
// Prix : source unique @mtc/shared (cf. .claude/agents/plans.md).
import {
  FOUNDER_OFFER,
  FOUNDER_REFUND_DAYS,
  PREMIUM_ANNUAL_SAVINGS_EUR,
  PREMIUM_PRICE_EUR,
} from '@mtc/shared';

// Ce que Premium ajoute au Gratuit : UNE liste, rendue deux fois (bloc « Ce que Premium
// ajoute » au-dessus des prix, et carte Premium). `key` = ancres réelles du Premium
// (cf. plans.md : Insights, Weekly Debrief, analytics avancés, comptes illimités ; le chat
// coach n'en fait pas partie). Retour de Val : le menu « Tarifs » arrivait sur les prix sans
// dire ce qui change, il fallait comparer deux listes en scrollant.
interface PremiumPlus { text: string; key?: string }
const premiumPlus: PremiumPlus[] = [
  { text: '✨ IA Insights : analyse de tes patterns', key: 'L’IA analyse tes patterns : ce qui te fait gagner, ce qui te coûte' },
  { text: '📋 Weekly Debrief automatique', key: 'Un débrief IA de ta semaine, chaque dimanche, sans rien faire' },
  { text: 'Analytics avancés : heatmap, equity curve', key: 'Analytics avancés : par setup, par heure, heatmap, equity curve' },
  { text: '🚨 Alertes prop firm en direct (Tradovate) : drawdown, perte du jour, consistency, objectif atteint, payout possible', key: 'Alertes prop firm et anti-tilt en direct pendant ta séance, avec le son (Tradovate)' },
  { text: '🔔 Alertes sonores pendant ta séance' },
  { text: '🧘 Anti-tilt en séance : revenge, taille, surtrading' },
  { text: '💬 Chat coach IA personnalisé' },
  { text: '🏆 Score trader /100 hebdomadaire' },
  { text: '📄 Export PDF rapport mensuel' },
  { text: '🌙 Recap 17h30 et Weekly Debrief nourris par tes séances suivies en direct' },
];
// Comptes illimités : déjà dans l'encart « comptes » de la carte, donc seulement dans le bloc.
const premiumKeys = [
  ...(FEATURES.multiAccounts ? ['Comptes de trading illimités, chacun avec ses règles prop firm'] : []),
  ...premiumPlus.flatMap((p) => (p.key ? [p.key] : [])),
];
---

<section class="pricing" id="pricing">
  <div class="wrap-wide">
    <div class="reveal head">
      <span class="sec-label">Tarifs</span>
      <h2>Simple. <em>Transparent.</em></h2>
      <p class="sec-sub">Gratuit pour vivre le compagnon au quotidien, trades illimités inclus. Premium pour la puissance IA personnelle. 1 mois offert sur le mensuel, aucun prélèvement avant la fin.</p>
    </div>
    <div class="plus-box reveal" aria-labelledby="plus-title">
      <div id="plus-title" class="plus-title">Ce que Premium ajoute au Gratuit</div>
      <ul class="plus-list">
        {premiumKeys.map((k) => <li>{k}</li>)}
      </ul>
    </div>
    <div class="price-grid reveal delay-1">

      <!-- FREE -->
      <div class="price-card">
        <div class="price-name">Gratuit</div>
        <div class="price-amt">
          <span class="price-amt-num">0</span>
          <span class="price-amt-cur">€</span>
        </div>
        <div class="price-period">pour toujours · aucune CB requise</div>
        {FEATURES.multiAccounts && (
          <div class="price-accts">
            <span class="acct-n">1</span>
            <span class="acct-t">compte de trading + ses règles prop firm</span>
          </div>
        )}
        <div class="price-divider"></div>
        <ul class="price-feats">
          <li>Trades illimités</li>
          <li>Journal complet : émotions, setup, notes</li>
          <li>🌅 Pré-session : humeur &amp; objectifs du jour</li>
          <li>⚡ Session live : trade rapide &amp; suivi</li>
          <li>📈 Suivi prop firm en direct dans la session</li>
          <li>🌙 Débrief de session : P&amp;L, émotion, journal</li>
          <li>📅 Calendrier éco IA : analyse bull/bear</li>
          <li>📰 News live &amp; contexte marché (DXY, taux US, indices)</li>
          <li>Stats de base : win rate, P&amp;L · Historique illimité</li>
          <li>🔗 Synchro Tradovate automatique (lecture seule) · Import CSV universel</li>
          <li>💰 Solde broker, objectif &amp; prochain payout</li>
        </ul>
        <a href={`${APP_URL}/register`} class="price-cta ghost" data-ga-event="cta_signup" data-ga-place="pricing-free">Commencer gratuitement</a>
      </div>

      <!-- FONDATEUR (#525) : absente du rendu tant que l'API ne dit pas que l'offre vend. Sans JS,
           offre fermée, épuisée ou API injoignable → 2 cartes, Premium « Recommandé ». -->
      <div class="price-card feat with-badge is-founder" data-founder-card hidden>
        <div class="price-pop">Réservé aux {FOUNDER_OFFER.seats} premiers</div>
        <div class="price-name">Fondateur</div>
        <div class="price-amt">
          <span class="price-amt-num">{FOUNDER_OFFER.priceMonthlyEur}</span>
          <span class="price-amt-cur">€</span>
          <span class="price-amt-per">/mois</span>
        </div>
        <div class="price-period">ou {FOUNDER_OFFER.priceAnnualEur} €/an</div>
        <ul class="founder-promises">
          <li>🔒 Prix bloqué à vie tant que ton abonnement reste actif</li>
          <li>Satisfait ou remboursé {FOUNDER_REFUND_DAYS} jours</li>
        </ul>
        <div class="founder-seats">
          <div class="founder-seats-text"><strong data-founder-left></strong> sur {FOUNDER_OFFER.seats}</div>
          <span class="founder-seats-bar" aria-hidden="true"><span class="founder-seats-fill"></span></span>
        </div>
        {FEATURES.multiAccounts && (
          <div class="price-accts">
            <span class="acct-n">∞</span>
            <span class="acct-t">comptes illimités, chacun avec ses règles prop firm</span>
          </div>
        )}
        <div class="price-divider"></div>
        <div class="price-plus-lead">Tout Premium <em>inclus :</em></div>
        <ul class="price-feats">
          {premiumPlus.map((p) => <li>{p.text}</li>)}
        </ul>
        <a href={`${APP_URL}/register?plan=founder&cta=carte`} class="price-cta prim" data-founder-cta data-ga-event="cta_founder" data-ga-place="pricing">
          <span class="cta-main">Devenir fondateur →</span>
          <span class="cta-sub-text">Paiement immédiat · sans essai</span>
        </a>
      </div>

      <!-- PREMIUM -->
      <div class="price-card feat with-badge is-premium">
        <div class="price-pop">⭐ Recommandé</div>
        <div class="price-name">Premium</div>
        <div class="price-amt">
          <span class="price-amt-num">{PREMIUM_PRICE_EUR.monthly}</span>
          <span class="price-amt-cur">€</span>
          <span class="price-amt-per">/mois</span>
        </div>
        <div class="price-period">ou {PREMIUM_PRICE_EUR.annual} €/an, tu économises {PREMIUM_ANNUAL_SAVINGS_EUR} €</div>
        {FEATURES.multiAccounts && (
          <div class="price-accts">
            <span class="acct-n">∞</span>
            <span class="acct-t">comptes illimités, chacun avec ses règles prop firm</span>
          </div>
        )}
        <div class="price-divider"></div>
        <div class="price-plus-lead">Tout le Gratuit, <em>plus :</em></div>
        <ul class="price-feats">
          {premiumPlus.map((p) => <li>{p.text}</li>)}
        </ul>
        <a href={`${APP_URL}/register?plan=premium`} class="price-cta prim" data-ga-event="cta_trial" data-ga-place="pricing">
          <span class="cta-main">Essayer Premium · 1 mois offert →</span>
          <span class="cta-sub-text">🔥 Carte requise · annulable en un clic</span>
        </a>
      </div>

    </div>
    <p class="founder-note" data-founder-note hidden>
      Le tarif fondateur n'a pas d'essai : le plan Gratuit sert d'essai. L'essai de 30 jours reste
      sur le Premium à {PREMIUM_PRICE_EUR.monthly} €/mois.
    </p>
    <div class="pricing-guarantee reveal">
      <div class="guarantee-item">✓ Annulation en un clic</div>
      <div class="guarantee-item">✓ Données exportables</div>
      <div class="guarantee-item">✓ Support Discord direct</div>
      <div class="guarantee-item">✓ Hébergé en France 🇫🇷</div>
    </div>
  </div>
</section>

<script>
  import { isSelling, onFounderState, placesLabel, rememberedCta } from '../lib/founder-offer';

  // Carte Fondateur : affichée seulement si l'offre vend, avec le VRAI compteur. Le changement se
  // fait au chargement, la section est très bas dans la page : aucun décalage visible (CLS).
  const section = document.getElementById('pricing');
  const card = section?.querySelector<HTMLElement>('[data-founder-card]');
  const note = section?.querySelector<HTMLElement>('[data-founder-note]');
  if (section && card) {
    onFounderState((s) => {
      const selling = isSelling(s);
      card.hidden = !selling;
      if (note) note.hidden = !selling;
      section.classList.toggle('has-founder', selling);
      if (!selling) return;
      const left = card.querySelector('[data-founder-left]');
      if (left) left.textContent = `${placesLabel(s.seatsLeft)} restante${s.seatsLeft > 1 ? 's' : ''}`;
      const fill = card.querySelector<HTMLElement>('.founder-seats-fill');
      if (fill) fill.style.transform = `scaleX(${(s.seatsTotal - s.seatsLeft) / s.seatsTotal})`;
    });
    // Point de clic : bandeau ou FAQ s'ils ont mené ici, sinon la carte elle-même.
    card.querySelector<HTMLAnchorElement>('[data-founder-cta]')?.addEventListener('click', (e) => {
      const cta = rememberedCta();
      const a = e.currentTarget as HTMLAnchorElement;
      if (cta === 'bandeau' || cta === 'faq') {
        const url = new URL(a.href);
        url.searchParams.set('cta', cta);
        a.href = url.toString();
      }
    });
  }
</script>

<style>
  .pricing { padding: 80px 5%; }
  /* Menu « Tarifs » (/#pricing) : le titre ne passe pas sous la barre fixe (60 px). */
  #pricing { scroll-margin-top: 64px; }

  /* Bloc « Ce que Premium ajoute » : lisible d'un coup d'œil, au-dessus des prix */
  .plus-box {
    max-width: 760px;
    margin: 32px auto 0;
    padding: 18px 22px;
    border: 1px solid rgba(59,130,246,.35);
    border-radius: 14px;
    background: rgba(59,130,246,.06);
  }
  .plus-title {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--blue2);
    margin-bottom: 10px;
  }
  .plus-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 20px;
  }
  .plus-list li {
    font-size: 13.5px;
    color: var(--txt);
    line-height: 1.45;
    display: flex;
    gap: 8px;
  }
  .plus-list li::before { content: '+'; color: var(--blue2); font-weight: 700; flex-shrink: 0; }

  .price-plus-lead {
    font-size: 13px;
    font-weight: 600;
    color: var(--txt);
    margin-bottom: 10px;
  }
  .price-plus-lead em { font-style: normal; color: var(--blue2); }
  .wrap-wide { max-width: 1200px; margin: 0 auto; }
  .head { text-align: center; max-width: 640px; margin: 0 auto; }
  .delay-1 { transition-delay: .1s; }
  /* Carte recommandée : place pour le badge « Recommandé » */
  .price-card.with-badge { padding-top: 44px; }
  .price-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 760px;
    margin: 48px auto 0;
  }

  .price-card {
    background: var(--card);
    border: 1px solid var(--b);
    border-radius: 16px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
  }

  .price-card.feat {
    border-color: rgba(59,130,246,.5);
    background: linear-gradient(160deg, rgba(59,130,246,.1), rgba(139,92,246,.07));
    box-shadow: 0 0 40px rgba(59,130,246,.12), inset 0 1px 0 rgba(255,255,255,.06);
    position: relative;
  }

  .price-pop {
    position: absolute;
    top: -14px; left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(90deg, var(--blue), #6366f1);
    color: white;
    font-size: 11px;
    font-family: var(--mono);
    font-weight: 700;
    padding: 5px 18px;
    border-radius: 100px;
    letter-spacing: .6px;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(59,130,246,.4);
  }

  .cta-main { display: block; font-size: 14px; font-weight: 600; }
  .cta-sub-text {
    display: block;
    font-size: 11px;
    font-weight: 400;
    opacity: .85;
    margin-top: 3px;
    font-family: var(--mono);
    letter-spacing: .3px;
  }

  .price-name {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--txt3);
    margin-bottom: 12px;
    text-align: center;
  }
  .price-card.feat .price-name { color: var(--blue2); }

  .price-amt {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 4px;
    justify-content: center;
  }

  .price-amt-num { font-family: var(--disp); font-size: 56px; font-weight: 800; letter-spacing: -2px; color: var(--txt); }
  .price-amt-cur { font-family: var(--disp); font-size: 22px; font-weight: 600; color: var(--txt2); }
  .price-amt-per { font-size: 14px; color: var(--txt3); }

  .price-period {
    font-size: 12px;
    color: var(--txt3);
    font-family: var(--mono);
    text-align: center;
  }

  .price-accts {
    margin: 16px 0 0;
    padding: 12px 14px;
    border-radius: 11px;
    background: rgba(59,130,246,.12);
    border: 1px solid var(--b);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .acct-n { font-family: var(--disp); font-weight: 700; font-size: 20px; color: var(--blue2); }
  .acct-t { font-size: 12.5px; color: var(--txt); line-height: 1.35; }

  .price-divider { height: 1px; background: var(--b); margin: 20px 0; }

  .price-feats {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-bottom: 24px;
    flex: 1;
  }

  .price-feats li {
    font-size: 13px;
    color: var(--txt2);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.5;
  }
  .price-feats li::before { content: '✓'; color: var(--green); flex-shrink: 0; font-weight: 600; margin-top: 1px; }

  .price-cta {
    display: block;
    width: 100%;
    padding: 12px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 600;
    font-family: var(--disp);
    text-align: center;
    text-decoration: none;
    transition: all .2s;
    cursor: pointer;
    border: none;
  }
  .price-cta.prim { background: linear-gradient(90deg, var(--blue), #6366f1); color: white; box-shadow: 0 0 28px rgba(59,130,246,.4); }
  .price-cta.prim:hover { transform: translateY(-1px); box-shadow: 0 0 36px rgba(59,130,246,.5); }
  .price-cta.ghost { background: transparent; color: var(--txt2); border: 1px solid var(--b2); }
  .price-cta.ghost:hover { color: var(--txt); border-color: var(--blue); background: rgba(59,130,246,.05); }

  .pricing-guarantee {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--b);
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }
  .guarantee-item { font-size: 12px; font-family: var(--mono); color: var(--txt3); }

  /* ── Offre fondateur : 3 cartes Gratuit · Fondateur · Premium ── */
  .price-card[hidden], .founder-note[hidden] { display: none; }
  .has-founder .price-grid { grid-template-columns: repeat(3, 1fr); max-width: 1140px; }
  /* Premium perd sa mise en avant au profit de la carte Fondateur. */
  .has-founder .is-premium {
    border-color: var(--b);
    background: var(--card);
    box-shadow: none;
    padding-top: 36px;
  }
  .has-founder .is-premium .price-pop { display: none; }
  .has-founder .is-premium .price-name { color: var(--txt3); }
  .founder-promises {
    list-style: none;
    margin: 14px 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: center;
    font-size: 12.5px;
    color: var(--txt);
  }
  .founder-seats { margin-top: 14px; }
  .founder-seats-text {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--txt2);
    text-align: center;
    margin-bottom: 6px;
  }
  .founder-seats-text strong { color: var(--txt); }
  .founder-seats-bar {
    display: block;
    height: 6px;
    border-radius: 100px;
    background: rgba(255,255,255,.08);
    overflow: hidden;
  }
  .founder-seats-fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--blue), #6366f1);
    transform: scaleX(0);
    transform-origin: left;
  }
  .founder-note {
    max-width: 760px;
    margin: 16px auto 0;
    text-align: center;
    font-size: 12px;
    color: var(--txt3);
  }

  @media (max-width: 1024px) {
    .has-founder .price-grid { grid-template-columns: 1fr; max-width: 480px; }
    /* Empilées : Fondateur en premier. */
    .has-founder .is-founder { order: -1; }
  }
  @media (max-width: 760px) {
    .price-grid { grid-template-columns: 1fr; gap: 20px; max-width: 480px; }
    .plus-box { max-width: 480px; padding: 16px; }
    .plus-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .price-card { padding: 24px 16px; }
  }
</style>
