---
import { FEATURES, APP_URL } from '../config';
// Prix : source unique @mtc/shared (cf. .claude/agents/plans.md).
import { PREMIUM_ANNUAL_SAVINGS_EUR, PREMIUM_PRICE_EUR } from '@mtc/shared';
---

<section id="pricing" style="padding:80px 5%">
  <div style="max-width:1200px;margin:0 auto">
    <div class="reveal" style="text-align:center;max-width:640px;margin:0 auto">
      <span class="sec-label">Tarifs</span>
      <h2>Simple. <em>Transparent.</em></h2>
      <p class="sec-sub">Gratuit pour vivre le compagnon au quotidien, trades illimités inclus. Premium pour la puissance IA personnelle. 1 mois offert sur le mensuel, aucun prélèvement avant la fin.</p>
    </div>
    <div class="price-grid reveal" style="transition-delay:.1s">

      <!-- FREE -->
      <div class="price-card">
        <div class="price-name">Gratuit</div>
        <div class="price-amt">
          <span class="price-amt-num">0</span>
          <span class="price-amt-cur">€</span>
        </div>
        <div class="price-period">pour toujours · aucune CB requise</div>
        {FEATURES.multiAccounts && (
          <div class="price-accts">
            <span class="acct-n">1</span>
            <span class="acct-t">compte de trading</span>
          </div>
        )}
        <div class="price-divider"></div>
        <ul class="price-feats">
          <li>Trades illimités</li>
          <li>Journal complet : émotions, setup, notes</li>
          <li>🌅 Pré-session : humeur &amp; objectifs du jour</li>
          <li>⚡ Session live : trade rapide &amp; suivi</li>
          <li>🌙 Débrief de session : P&amp;L, émotion, journal</li>
          <li>📅 Calendrier éco IA : analyse bull/bear</li>
          <li>📰 News live &amp; contexte marché (DXY, taux US, indices)</li>
          <li>Stats de base : win rate, P&amp;L · Historique illimité</li>
          <li>Import CSV universel · Futures, Crypto, Forex</li>
        </ul>
        <a href={`${APP_URL}/register`} class="price-cta ghost">Commencer gratuitement</a>
      </div>

      <!-- PREMIUM -->
      <div class="price-card feat" style="padding-top:44px">
        <div class="price-pop">⭐ Recommandé</div>
        <div class="price-name">Premium</div>
        <div class="price-amt">
          <span class="price-amt-num">{PREMIUM_PRICE_EUR.monthly}</span>
          <span class="price-amt-cur">€</span>
          <span class="price-amt-per">/mois</span>
        </div>
        <div class="price-period">ou {PREMIUM_PRICE_EUR.annual} €/an, tu économises {PREMIUM_ANNUAL_SAVINGS_EUR} €</div>
        {FEATURES.multiAccounts && (
          <div class="price-accts">
            <span class="acct-n">∞</span>
            <span class="acct-t">comptes illimités + règles prop firm par compte</span>
          </div>
        )}
        <div class="price-divider"></div>
        <ul class="price-feats">
          <li>Tout le plan Gratuit inclus</li>
          <li>✨ IA Insights : analyse de tes patterns</li>
          <li>💬 Chat coach IA personnalisé</li>
          <li>📋 Weekly Debrief automatique</li>
          <li>🏆 Score trader /100 hebdomadaire</li>
          <li>Analytics avancés : heatmap, equity curve</li>
          <li>📄 Export PDF rapport mensuel</li>
          <li>🌙 Recap journalier email 17h30</li>
        </ul>
        <a href={`${APP_URL}/register?plan=premium`} class="price-cta prim">
          <span class="cta-main">Essayer Premium · 1 mois offert →</span>
          <span class="cta-sub-text">🔥 Carte requise · annulable en un clic</span>
        </a>
      </div>

    </div>
    <div class="pricing-guarantee reveal">
      <div class="guarantee-item">✓ Annulation en un clic</div>
      <div class="guarantee-item">✓ Données exportables</div>
      <div class="guarantee-item">✓ Support Discord direct</div>
      <div class="guarantee-item">✓ Hébergé en France 🇫🇷</div>
    </div>
  </div>
</section>

<style>
  .price-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 760px;
    margin: 48px auto 0;
  }

  .price-card {
    background: var(--card);
    border: 1px solid var(--b);
    border-radius: 16px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
  }

  .price-card.feat {
    border-color: rgba(59,130,246,.5);
    background: linear-gradient(160deg, rgba(59,130,246,.1), rgba(139,92,246,.07));
    box-shadow: 0 0 40px rgba(59,130,246,.12), inset 0 1px 0 rgba(255,255,255,.06);
    position: relative;
  }

  .price-pop {
    position: absolute;
    top: -14px; left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(90deg, var(--blue), #6366f1);
    color: white;
    font-size: 11px;
    font-family: var(--mono);
    font-weight: 700;
    padding: 5px 18px;
    border-radius: 100px;
    letter-spacing: .6px;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(59,130,246,.4);
  }

  .cta-main { display: block; font-size: 14px; font-weight: 600; }
  .cta-sub-text {
    display: block;
    font-size: 11px;
    font-weight: 400;
    opacity: .85;
    margin-top: 3px;
    font-family: var(--mono);
    letter-spacing: .3px;
  }

  .price-name {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--txt3);
    margin-bottom: 12px;
    text-align: center;
  }
  .price-card.feat .price-name { color: var(--blue2); }

  .price-amt {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 4px;
    justify-content: center;
  }

  .price-amt-num { font-family: var(--disp); font-size: 56px; font-weight: 800; letter-spacing: -2px; color: var(--txt); }
  .price-amt-cur { font-family: var(--disp); font-size: 22px; font-weight: 600; color: var(--txt2); }
  .price-amt-per { font-size: 14px; color: var(--txt3); }

  .price-period {
    font-size: 12px;
    color: var(--txt3);
    font-family: var(--mono);
    text-align: center;
  }

  .price-accts {
    margin: 16px 0 0;
    padding: 12px 14px;
    border-radius: 11px;
    background: rgba(59,130,246,.12);
    border: 1px solid var(--b);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .acct-n { font-family: var(--disp); font-weight: 700; font-size: 20px; color: var(--blue2); }
  .acct-t { font-size: 12.5px; color: var(--txt); line-height: 1.35; }

  .price-divider { height: 1px; background: var(--b); margin: 20px 0; }

  .price-feats {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-bottom: 24px;
    flex: 1;
  }

  .price-feats li {
    font-size: 13px;
    color: var(--txt2);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.5;
  }
  .price-feats li::before { content: '✓'; color: var(--green); flex-shrink: 0; font-weight: 600; margin-top: 1px; }

  .price-cta {
    display: block;
    width: 100%;
    padding: 12px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 600;
    font-family: var(--disp);
    text-align: center;
    text-decoration: none;
    transition: all .2s;
    cursor: pointer;
    border: none;
  }
  .price-cta.prim { background: linear-gradient(90deg, var(--blue), #6366f1); color: white; box-shadow: 0 0 28px rgba(59,130,246,.4); }
  .price-cta.prim:hover { transform: translateY(-1px); box-shadow: 0 0 36px rgba(59,130,246,.5); }
  .price-cta.ghost { background: transparent; color: var(--txt2); border: 1px solid var(--b2); }
  .price-cta.ghost:hover { color: var(--txt); border-color: var(--blue); background: rgba(59,130,246,.05); }

  .pricing-guarantee {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--b);
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }
  .guarantee-item { font-size: 12px; font-family: var(--mono); color: var(--txt3); }

  @media (max-width: 760px) {
    .price-grid { grid-template-columns: 1fr; gap: 20px; max-width: 480px; }
  }
  @media (max-width: 480px) {
    .price-card { padding: 24px 16px; }
  }
</style>
