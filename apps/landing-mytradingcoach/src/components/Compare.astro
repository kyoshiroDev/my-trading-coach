---
// Une seule source de verite pour les lignes : le tableau desktop (5 colonnes) et
// la version mobile (2 colonnes) sont rendus depuis les memes donnees, donc ils ne
// peuvent pas diverger. En mobile, les 3 concurrents sont fusionnes en « Les autres ».
import { PREMIUM_PRICE_EUR } from '@mtc/shared';

type Val = boolean | string;

interface Row {
  label: string;
  isNew?: boolean;
  pulse?: boolean;  // coche MTC en couleur accent
  hl?: boolean;     // ligne mise en avant
  mtc: Val;
  rivals: [Val, Val, Val];  // TraderSync · TradesViz · Edgely
  othersLabel?: string;     // fusion explicite quand les valeurs ne sont pas booleennes
}

const rows: Row[] = [
  { label: 'Journal de trading', mtc: true, rivals: [true, true, true] },
  { label: 'Analytics avancés', mtc: true, rivals: [true, true, true] },
  { label: 'Tracking émotionnel', mtc: true, rivals: [false, false, false] },
  { label: 'Coach IA conversationnel', mtc: true, rivals: [false, false, false] },
  { label: 'Weekly Debrief IA automatique', mtc: true, rivals: [false, false, false], pulse: true, hl: true },
  { label: 'Pré-session matin', isNew: true, mtc: true, rivals: [false, false, false], pulse: true },
  { label: 'Session live + trade rapide', isNew: true, mtc: true, rivals: [false, false, false], pulse: true },
  { label: 'Calendrier éco IA filtré', isNew: true, mtc: true, rivals: [false, false, false], pulse: true },
  { label: 'Recap journalier email 17h30', isNew: true, mtc: true, rivals: [false, false, false], pulse: true },
  { label: 'Import CSV universel (broker-agnostic)', mtc: true, rivals: [true, true, false] },
  { label: 'Hébergé en France 🇫🇷', mtc: true, rivals: [false, false, false] },
    // Les deux paliers : « dès 0 € » seul laissait croire que toutes les coches MTC
    // (Coach IA, débrief hebdo, récap 17h30…) sont gratuites alors qu'une partie est Premium.
    // Prix tiré de @mtc/shared : aucune valeur en dur sur la landing.
    { label: 'Prix mensuel', mtc: `0 € (Gratuit) · dès ${PREMIUM_PRICE_EUR.monthly} € (Premium)`, rivals: ['30-80 $', '10-29 $', '~€15'], othersLabel: '10-80 $' },
];

type Cell = { cls: string; text: string; accent?: boolean };

const cell = (v: Val, opts: { pulse?: boolean; hlPrice?: boolean } = {}): Cell => {
  if (v === true) return { cls: 'comp-yes', text: '✓', accent: opts.pulse };
  if (v === false) return { cls: 'comp-no', text: '-' };
  return { cls: opts.hlPrice ? 'comp-price-hl' : 'comp-price', text: v };
};

// Fusion « Les autres » : ✓ seulement si les trois l'ont, - seulement si aucun ne
// l'a. Des que c'est mixte on affiche « partiel » — jamais un - qui effacerait un
// concurrent qui propose la fonctionnalite.
const merge = (row: Row): Cell => {
  if (row.othersLabel) return { cls: 'comp-price', text: row.othersLabel };
  const bools = row.rivals.filter((v): v is boolean => typeof v === 'boolean');
  if (bools.length !== row.rivals.length) return { cls: 'comp-partial', text: 'partiel' };
  if (bools.every(Boolean)) return { cls: 'comp-yes', text: '✓' };
  if (!bools.some(Boolean)) return { cls: 'comp-no', text: '-' };
  return { cls: 'comp-partial', text: 'partiel' };
};
---

<section class="comp-section" id="compare">
  <div class="wrap">
    <div class="reveal head">
      <span class="sec-label">Comparaison</span>
      <h2>Pourquoi MyTradingCoach <em>plutôt que</em> les autres ?</h2>
      <p class="sec-sub intro">Les autres journaux de trading analysent après. MTC supervise avant, pendant et après.</p>
    </div>
    <div class="reveal">
      <div class="table-wrapper">
        <table class="comp-table">
          <thead>
            <tr>
              <th class="th-left">Fonctionnalité</th>
              <th class="hl">MyTrading<wbr />Coach</th>
              <th class="c-rival">TraderSync</th>
              <th class="c-rival">TradesViz</th>
              <th class="c-rival">Edgely</th>
              <th class="c-others">Les autres</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => {
              const mtc = cell(row.mtc, { pulse: row.pulse, hlPrice: typeof row.mtc === 'string' });
              const others = merge(row);
              return (
                <tr class={row.hl ? 'row-hl' : undefined}>
                  <td class={row.hl ? 'cell-hl' : undefined}>
                    {row.label}{row.isNew && <span class="comp-new">NEW</span>}
                  </td>
                  <td><span class={mtc.cls} style={mtc.accent ? 'color:var(--pulse)' : undefined}>
                    {mtc.text.split(' · ').map((part, i) => (
                      <>{i > 0 && <span class="comp-price-sep"> · </span>}<span class="comp-price-part">{part}</span></>
                    ))}
                  </span></td>
                  {row.rivals.map((v) => {
                    const c = cell(v);
                    return <td class="c-rival"><span class={c.cls}>{c.text}</span></td>;
                  })}
                  <td class="c-others"><span class={others.cls}>{others.text}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="comp-note">Données basées sur les fonctionnalités publiquement documentées · Mise à jour mai 2026</p>
    </div>
  </div>
</section>

<style>
  .th-left { text-align: left; }
  .intro { margin: 0 auto; text-align: center; max-width: 500px; }
  .head { text-align: center; }
  .comp-section {
    background: var(--bg2);
    border-top: 1px solid var(--b);
  }

  .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-top: 40px;
    border-radius: 12px;
    border: 1px solid var(--b);
  }

  .comp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .comp-table th {
    padding: 14px 18px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--txt3);
    text-align: center;
    text-transform: uppercase;
    border-bottom: 1px solid var(--b);
    background: var(--card);
  }
  .comp-table th:first-child { text-align: left; }
  .comp-table th.hl { color: var(--pulse); }

  .comp-table td {
    padding: 12px 18px;
    border-bottom: 1px solid rgba(99,155,255,.05);
    color: var(--txt2);
    text-align: center;
  }
  .comp-table td:first-child { text-align: left; color: var(--txt); font-weight: 400; }
  .comp-table tr:last-child td { border-bottom: none; }
  .comp-table tr:hover td { background: rgba(99,155,255,.02); }

  .row-hl { background: rgba(34,211,238,.02); }
  .comp-table .row-hl .cell-hl { font-weight: 500; color: var(--txt); }

  /* Colonne agregee « Les autres » : absente en desktop, elle remplace les trois
     colonnes concurrentes en mobile. Une seule source de donnees, zero duplication. */
  .comp-table .c-others { display: none; }

  .comp-yes { color: var(--green); font-size: 14px; }
  .comp-no  { color: var(--txt3); }
  /* Fusion mixte : au moins un concurrent propose la fonctionnalite. */
  .comp-partial { color: var(--txt3); font-family: var(--mono); font-size: 11px; }
  .comp-price { font-family: var(--mono); font-size: 12px; }
  /* Chaque palier reste sur une ligne ; la coupure ne peut tomber qu'après le « · ». */
  .comp-price-part { white-space: nowrap; }
  @media (max-width: 767px) {
    /* Colonne étroite : un palier par ligne, sans « · » orphelin entre les deux. */
    .comp-price-sep { display: none; }
    .comp-price-part { display: block; white-space: normal; font-size: 12px; }
  }
  .comp-price-hl { font-family: var(--mono); font-size: 13px; font-weight: 600; color: var(--pulse); }
  .comp-new {
    margin-left: 6px;
    white-space: nowrap;
    font-size: 9px;
    background: rgba(245,158,11,.1);
    color: var(--yel);
    border: 1px solid rgba(245,158,11,.2);
    padding: 2px 6px;
    border-radius: 3px;
    font-family: var(--mono);
    font-weight: 700;
  }

  .comp-note {
    font-size: 11px;
    color: var(--txt3);
    font-family: var(--mono);
    margin-top: 14px;
    text-align: center;
  }

  @media (max-width: 768px) {
    .comp-section { padding: 64px 16px; }
    /* Plus de min-width : les 3 colonnes restantes tiennent dans le viewport,
       donc plus de scroll horizontal. */
    .comp-table { font-size: 12px; table-layout: fixed; }
    .comp-table th, .comp-table td { padding: 10px 8px; }
    .comp-table th { font-size: 9px; letter-spacing: .5px; overflow-wrap: break-word; }
    .table-wrapper { margin-top: 28px; border-radius: 8px; }

    .comp-table .c-rival { display: none; }
    .comp-table .c-others { display: table-cell; }

    .comp-table th:first-child, .comp-table td:first-child { width: 52%; }
    .comp-table th:not(:first-child), .comp-table td:not(:first-child) { width: 24%; }
  }
</style>
