---
import { APP_URL, TRADERS_PUBLIC_THRESHOLD } from '../config';
import { TEMOIGNAGES } from '../data/temoignages';
const { traders = 0 } = Astro.props;
const showTraders = traders >= TRADERS_PUBLIC_THRESHOLD;

/*
 * Rien a montrer = on ne montre rien. La section annoncait « les retours des premiers
 * utilisateurs façonnent le produit, rejoins-les » sans une seule citation : elle promettait
 * une preuve et livrait un bouton, juste apres le prix. Mieux vaut l'absence que la promesse
 * creuse. Des qu'un vrai temoignage arrive dans `src/data/temoignages.ts`, elle reapparait.
 */
const aQuelqueChoseAMontrer = TEMOIGNAGES.length > 0 || showTraders;
---

{aQuelqueChoseAMontrer && (
<section class="social-proof" id="temoignages">
  <div class="reveal" style="text-align:center;max-width:560px;margin:0 auto">
    <span class="sec-label">Depuis le lancement</span>
    <h2>Construit avec <em>les premiers traders</em></h2>
    {showTraders ? (
      <p class="sec-sub" data-traders-proof>
        Depuis son lancement, MyTradingCoach réunit déjà <span data-traders-count>{traders}</span> traders. Leurs retours
        façonnent le produit chaque semaine. Rejoins-les.
      </p>
    ) : (
      <p class="sec-sub">
        Les retours des premiers utilisateurs façonnent le produit chaque semaine. Rejoins-les.
      </p>
    )}
    <a href={`${APP_URL}/register`} class="join-cta">
      Commencer gratuitement →
    </a>
  </div>

  {TEMOIGNAGES.length > 0 && (
    <div class="temoignages reveal">
      {TEMOIGNAGES.map((t) => (
        <figure class="temoignage">
          <blockquote>{t.citation}</blockquote>
          <figcaption>
            <strong>{t.nom}</strong>
            <span>{t.profil}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  )}
</section>
)}

<style>
  .social-proof { padding: 80px 5%; }

  .temoignages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    max-width: 1000px;
    margin: 40px auto 0;
  }

  .temoignage {
    margin: 0;
    padding: 22px;
    background: var(--card);
    border: 1px solid var(--b);
    border-radius: 12px;
    text-align: left;
  }

  .temoignage blockquote {
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--txt);
  }

  .temoignage figcaption { display: flex; flex-direction: column; gap: 2px; }
  .temoignage figcaption strong { font-size: 14px; color: var(--txt); }
  .temoignage figcaption span { font-family: var(--mono); font-size: 12px; color: var(--txt3); }

  .join-cta {
    display: inline-block;
    margin-top: 24px;
    padding: 13px 26px;
    border-radius: 10px;
    background: linear-gradient(90deg, var(--blue), #6366f1);
    color: #fff;
    font-family: var(--disp);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 0 28px rgba(59, 130, 246, 0.35);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .join-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 36px rgba(59, 130, 246, 0.5);
  }

  @media (max-width: 768px) {
    .social-proof { padding: 64px 16px; }
  }
</style>
