---
// Carrousel des prop firms couvertes, dans « Ta prop firm, en direct » (sous le sous-titre).
// Noms en wordmark, pas de logos : citer une firm pour dire « compatible avec » est un usage
// normal, son logo laisserait croire à un partenariat. Liste lue AU BUILD dans le catalogue de
// l'app : une firm ajoutée apparaît seule. Défilement en CSS, pause au survol, liste fixe si
// « réduire les animations ». Un clic sur un nom choisit la firm : géré par le script de
// PropFirmLive (attribut data-pf-pick).
import { buildPropFirmCatalog } from '../data/prop-firm-catalog';

const catalog = buildPropFirmCatalog();
---

<div class="pfm reveal">
  <p class="pfm-title">Choisis ta firm</p>
  <div class="pfm-viewport">
    <div class="pfm-track">
      <ul class="pfm-row">
        {catalog.map((f) => <li><button type="button" data-pf-pick={f.id}>{f.name}</button></li>)}
      </ul>
      {/* Seconde copie pour boucler sans saut : masquée aux lecteurs d'écran et hors tabulation. */}
      <ul class="pfm-row pfm-dup" aria-hidden="true">
        {catalog.map((f) => <li><button type="button" tabindex="-1" data-pf-pick={f.id}>{f.name}</button></li>)}
      </ul>
    </div>
  </div>
</div>

<style>
  .pfm { margin: 40px auto 0; max-width: 1000px; text-align: center; }

  .pfm-title {
    margin: 0 0 10px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--txt3);
  }

  /* Fondu sur les bords de la zone visible : les noms apparaissent et disparaissent au lieu d'être coupés net. */
  .pfm-viewport {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .pfm-track {
    display: flex;
    width: max-content;
    animation: pfm-scroll 60s linear infinite;
  }
  .pfm:hover .pfm-track,
  .pfm:focus-within .pfm-track { animation-play-state: paused; }

  .pfm-row {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pfm-row li { display: flex; align-items: center; white-space: nowrap; }
  /* Séparateur maison : le point médian du site. */
  .pfm-row li::after {
    content: '·';
    margin: 0 22px;
    color: var(--b2);
  }
  .pfm-row button {
    background: none;
    border: 0;
    padding: 6px 2px;
    cursor: pointer;
    font-family: var(--disp);
    font-weight: 600;
    font-size: clamp(16px, 1.8vw, 20px);
    letter-spacing: -0.01em;
    color: var(--txt2);
    transition: color 0.2s;
  }
  .pfm-row button:hover { color: var(--blue2); }
  .pfm-row button:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; border-radius: 4px; }

  /* La seconde copie fait exactement une largeur de liste : -50 % = une boucle sans saut. */
  @keyframes pfm-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pfm-viewport { mask-image: none; -webkit-mask-image: none; }
    .pfm-track { animation: none; width: auto; justify-content: center; }
    .pfm-row { flex-wrap: wrap; justify-content: center; row-gap: 4px; }
    .pfm-dup { display: none; }
  }
</style>
