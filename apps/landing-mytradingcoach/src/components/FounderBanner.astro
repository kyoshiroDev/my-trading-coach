---
// Bandeau « Offre fondateur » (#525), au-dessus de la Nav sur toutes les pages (inclus par Nav).
// Masqué dans le HTML : il n'apparaît que si l'API dit que l'offre vend (ouverte, places > 0).
// Fermée, épuisée ou API injoignable → rien (jamais de chiffre inventé).
//
// Zéro décalage de mise en page : le bandeau est fixe et la Nav descend par `transform` (qui ne
// compte pas dans le CLS) ; le contenu ne bouge pas, il passe sous les 32 px du bandeau, pris sur
// la marge haute des premières sections (≥ 40 px sur toutes les pages ; sur l'accueil, le bandeau
// « Fait en France » collé sous la Nav descend lui aussi, attribut `data-offer-shift`).
import { FOUNDER_OFFER } from '@mtc/shared';
---

<div class="offer-bar" id="offer-bar" hidden>
  <a href="/#pricing" class="offer-link" data-offer-cta="bandeau" data-ga-event="cta_founder" data-ga-place="bandeau">
    <span class="offer-long">
      🔥 <strong>Offre fondateur</strong> · Premium à <strong>{FOUNDER_OFFER.priceMonthlyEur} €/mois à vie</strong>
      pour les {FOUNDER_OFFER.seats} premiers · <strong data-offer-left-long></strong> →
    </span>
    <span class="offer-short">🔥 Fondateur {FOUNDER_OFFER.priceMonthlyEur} €/mois · <span data-offer-left-short></span> →</span>
  </a>
  <button type="button" class="offer-close" aria-label="Fermer le bandeau de l'offre fondateur">×</button>
  <span class="offer-progress" aria-hidden="true"><span class="offer-progress-fill"></span></span>
</div>

<script>
  import { isSelling, onFounderState, placesLabel, rememberCta } from '../lib/founder-offer';

  const CLOSED_KEY = 'mtc_offer_bar_closed';
  const bar = document.getElementById('offer-bar');
  const closed = () => {
    try {
      return sessionStorage.getItem(CLOSED_KEY) === '1';
    } catch {
      return false;
    }
  };

  const hide = () => {
    if (bar) bar.hidden = true;
    document.documentElement.classList.remove('has-offer-bar');
  };

  if (bar && !closed()) {
    onFounderState((s) => {
      if (!isSelling(s) || closed()) return hide();
      const left = s.seatsLeft;
      const long = bar.querySelector('[data-offer-left-long]');
      const short = bar.querySelector('[data-offer-left-short]');
      if (long) long.textContent = left === 1 ? "Plus qu'une place" : `Plus que ${placesLabel(left)}`;
      if (short) short.textContent = placesLabel(left);
      const fill = bar.querySelector<HTMLElement>('.offer-progress-fill');
      if (fill) fill.style.transform = `scaleX(${(s.seatsTotal - left) / s.seatsTotal})`;
      bar.hidden = false;
      document.documentElement.classList.add('has-offer-bar');
    });

    bar.querySelector('.offer-link')?.addEventListener('click', () => rememberCta('bandeau'));
    bar.querySelector('.offer-close')?.addEventListener('click', () => {
      try {
        sessionStorage.setItem(CLOSED_KEY, '1');
      } catch {
        /* sans stockage : fermé pour cette page seulement */
      }
      hide();
    });
  }
</script>

<style>
  .offer-bar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 202;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 40px;
    background: linear-gradient(90deg, rgba(59,130,246,.95), rgba(99,102,241,.95));
    color: #fff;
    font-size: 13px;
    line-height: 1;
  }
  .offer-bar[hidden] { display: none; }
  .offer-link {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .offer-link:hover { text-decoration: underline; }
  .offer-short { display: none; }
  .offer-close {
    position: absolute;
    right: 8px; top: 50%;
    transform: translateY(-50%);
    width: 28px; height: 28px;
    border: none;
    background: transparent;
    color: #fff;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    opacity: .85;
  }
  .offer-close:hover { opacity: 1; }
  .offer-progress {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: rgba(255,255,255,.25);
  }
  .offer-progress-fill {
    display: block;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }
  @media (max-width: 767px) {
    .offer-bar { font-size: 12.5px; padding: 0 36px 0 12px; }
    .offer-long { display: none; }
    .offer-short { display: inline; }
  }
</style>

<style is:global>
  /* Bandeau affiché : la Nav descend de 32 px par transform (pas de saut de mise en page). Menu
     mobile ouvert : la Nav remonte, le menu plein écran couvre le bandeau. */
  html.has-offer-bar body:not(.nav-open) .nav-bar { transform: translateY(32px); }
  /* Élément collé sous la Nav sans marge (bandeau « Fait en France » de l'accueil) : il descend
     aussi, sur la marge haute de la section suivante. */
  html.has-offer-bar [data-offer-shift] { transform: translateY(32px); }
  /* Ancres (#offre-fondateur, #faq…) : sous la Nav (60 px) ET le bandeau (32 px). #pricing garde
     ses 4 px d'air habituels au-dessus du titre. */
  html.has-offer-bar { scroll-padding-top: 92px; }
  html.has-offer-bar #pricing { scroll-margin-top: 4px; }
</style>
