---
import { GA_ID } from '../config';

// Rendu uniquement si une mesure d'audience est configurée (PUBLIC_GA_ID) :
// sans traceur, aucun consentement à demander (et la politique de confidentialité suit).
---
{GA_ID && (
  <div
    id="cookie-consent"
    class="cc"
    role="region"
    aria-label="Consentement aux cookies"
    hidden
  >
    <p class="cc-txt">
      On utilise des cookies de mesure d'audience pour comprendre comment tu utilises le site.
      Aucune donnée vendue ou partagée.
      <a href="/politique-confidentialite#cookies" class="cc-link">En savoir plus</a>
    </p>
    <div class="cc-actions">
      <button type="button" class="cc-btn cc-refuse" data-cc="refused">Refuser</button>
      <button type="button" class="cc-btn cc-accept" data-cc="accepted">Accepter</button>
    </div>
  </div>
)}
{/* Réserve en bas de page la hauteur du bandeau tant qu'il est affiché : il ne masque jamais
    le contenu, le pied de page (et le wordmark NinjaTrader) reste lisible en entier. */}
{GA_ID && <div id="cookie-consent-spacer" class="cc-spacer" aria-hidden="true" hidden></div>}

<script>
  // RGPD : ce bandeau ne fait que recueillir le choix. Le chargement de GA4 vit dans
  // Analytics.astro, qui ne réagit qu'à « accepted » (stocké ou émis via `mtc:consent`).
  // Choix stocké dans localStorage `mtc_cookie_consent` = { value, ts }.
  import { readConsent, saveConsent, type Consent } from '../lib/consent';

  const banner = document.getElementById('cookie-consent');
  const spacer = document.getElementById('cookie-consent-spacer');

  // Hauteur mesurée (pas en dur) : elle change avec la largeur (texte sur 1 à 3 lignes,
  // bandeau compact en mobile) ; le ResizeObserver la recalcule au redimensionnement.
  function syncSpacer() {
    if (!banner || !spacer) return;
    const visible = !banner.hidden;
    spacer.hidden = !visible;
    spacer.style.setProperty('--cc-h', visible ? `${banner.offsetHeight}px` : '0px');
  }
  if (banner) new ResizeObserver(syncSpacer).observe(banner);

  function show() { banner?.removeAttribute('hidden'); syncSpacer(); }
  function hide() { banner?.setAttribute('hidden', ''); syncSpacer(); }

  if (banner) {
    if (readConsent() === null) show();

    banner.querySelectorAll<HTMLButtonElement>('[data-cc]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.dataset.cc as Consent;
        saveConsent(value);
        hide();
        window.dispatchEvent(new CustomEvent<Consent>('mtc:consent', { detail: value }));
      });
    });

    // Lien « Gérer les cookies » (footer) : retirer son choix doit être aussi simple que le donner.
    document.querySelectorAll('[data-cookie-settings]').forEach((el) => {
      el.removeAttribute('hidden');
      el.addEventListener('click', (e) => { e.preventDefault(); show(); });
    });
  }
</script>

<style>
  .cc {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    /* Au-dessus de la barre sticky mobile (999), sous le menu plein écran (9999). */
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 14px 5%;
    background: rgba(8,12,20,0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid var(--b);
    font-family: var(--body);
  }
  .cc[hidden] { display: none; }

  .cc-spacer { height: var(--cc-h, 0px); }
  .cc-spacer[hidden] { display: none; }

  .cc-txt {
    font-size: 13px;
    line-height: 1.5;
    color: var(--txt2);
    max-width: 720px;
  }
  .cc-link { color: var(--blue2); text-decoration: none; white-space: nowrap; transition: color .2s; }
  .cc-link:hover { color: var(--txt); }

  .cc-actions { display: flex; gap: 10px; flex-shrink: 0; }

  /* Même taille, même graisse : refuser doit être aussi simple qu'accepter (CNIL). */
  .cc-btn {
    min-width: 108px;
    padding: 8px 16px;
    border-radius: 7px;
    font-family: var(--body);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background .2s, border-color .2s, color .2s, box-shadow .2s;
  }
  .cc-accept {
    background: var(--blue);
    color: #fff;
    border: 1px solid var(--blue);
  }
  .cc-accept:hover {
    background: var(--blue2);
    border-color: var(--blue2);
    box-shadow: 0 0 20px rgba(59,130,246,.3);
  }
  .cc-refuse {
    background: transparent;
    color: var(--txt);
    border: 1px solid var(--b2);
  }
  .cc-refuse:hover { border-color: var(--blue); background: rgba(59,130,246,.05); }
  .cc-btn:focus-visible { outline: 2px solid var(--blue2); outline-offset: 2px; }

  /* Mobile compact (≈ 90 px au lieu de 138) : texte à gauche, les deux boutons empilés à droite,
     toujours même taille et même graisse. Arrivé de la pub sur la carte Fondateur, le bandeau ne
     doit pas couvrir son bouton. */
  @media (max-width: 767px) {
    .cc {
      gap: 12px;
      padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      /* Opaque : la barre sticky bleue (Nav) ne doit pas transparaître dessous. */
      background: var(--bg2);
    }
    .cc-txt { font-size: 12px; line-height: 1.4; }
    .cc-actions { flex-direction: column; gap: 6px; }
    .cc-btn { min-width: 96px; padding: 7px 12px; font-size: 12.5px; }
  }
</style>
