---
// Texte : src/data/faq.ts (même source que le JSON-LD FAQPage de la home).
import { FAQ, FOUNDER_FAQ } from '../data/faq';
---

<section class="faq-section" id="faq">
  <div class="wrap">
    <div class="reveal head">
      <span class="sec-label">Questions fréquentes</span>
      <h2>Tout ce que tu veux <em>savoir</em></h2>
    </div>
    <div class="faq-list reveal">
      {/* Gabarit inerte : inséré seulement si l'offre vend ou s'est clôturée (aucun texte de
           l'offre dans le HTML rendu ni indexé avant). */}
      <template data-founder-faq-tpl>
      <div class="faq-item" data-founder-faq>
        <button class="faq-q" aria-expanded="false" aria-controls="faq-a-founder">
          {FOUNDER_FAQ.question}
          <span class="faq-arrow" aria-hidden="true">▼</span>
        </button>
        <div class="faq-a" id="faq-a-founder" role="region">
          <span data-founder-faq-open>
            {FOUNDER_FAQ.open}
            <a href="#pricing" class="faq-founder-link" data-offer-cta="faq">Voir l'offre fondateur →</a>
          </span>
          <span data-founder-faq-ended hidden>{FOUNDER_FAQ.ended}</span>
        </div>
      </div>
      </template>
      {FAQ.map((item, i) => (
        <div class={i === 0 ? 'faq-item open' : 'faq-item'}>
          {/* `aria-controls` lie la question a sa reponse : sans lui, un lecteur d'ecran
              annonce « developpe » sans dire ce qui s'ouvre, ni ou aller le lire. */}
          <button class="faq-q" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-a-${i}`}>
            {item.question}
            <span class="faq-arrow" aria-hidden="true">▼</span>
          </button>
          <div class="faq-a" id={`faq-a-${i}`} role="region">{item.answer}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .head { text-align: center; }
  .faq-section {
    background: var(--bg2);
    border-top: 1px solid var(--b);
  }

  .faq-list {
    max-width: 720px;
    margin: 40px auto 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .faq-item { border-bottom: 1px solid var(--b); }

  .faq-q {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    cursor: pointer;
    font-size: 15px;
    font-weight: 500;
    color: var(--txt);
    transition: color .15s;
    gap: 16px;
    user-select: none;
    background: none;
    border: none;
    font-family: var(--disp);
    text-align: left;
  }
  .faq-q:hover { color: var(--blue2); }

  .faq-arrow {
    color: var(--txt3);
    font-size: 12px;
    flex-shrink: 0;
    transition: transform .2s;
  }
  .faq-item.open .faq-arrow { transform: rotate(180deg); }

  .faq-a {
    font-size: 14px;
    color: var(--txt2);
    line-height: 1.7;
    padding-bottom: 16px;
    display: none;
    font-weight: 300;
  }
  .faq-item.open .faq-a { display: block; }
  .faq-a [hidden] { display: none; }
  .faq-founder-link { display: inline-block; margin-top: 8px; color: var(--blue2); text-decoration: none; }
  .faq-founder-link:hover { text-decoration: underline; }

  @media (max-width: 768px) {
    .faq-section { padding: 64px 16px; }
    .faq-q { font-size: 14px; }
  }

  @media (max-width: 480px) {
    .faq-section { padding: 56px 14px; }
  }
</style>

<script>
  import { isSelling, onFounderState, rememberCta } from '../lib/founder-offer';

  /** Bascule ouvert / fermé d'une question (une seule ouverte à la fois). */
  const toggle = (btn: Element) => {
    const item = btn.closest('.faq-item');
    const wasOpen = item?.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach((x) => {
      x.classList.remove('open');
      x.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
    });
    if (!wasOpen && item) {
      item.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
    }
  };

  // Question « offre fondateur » : insérée depuis son <template> si l'offre vend ou s'est
  // clôturée, jamais avant ; retirée sinon.
  const faqTpl = document.querySelector<HTMLTemplateElement>('template[data-founder-faq-tpl]');
  if (faqTpl) {
    onFounderState((s) => {
      const selling = isSelling(s);
      let item = document.querySelector<HTMLElement>('[data-founder-faq]');
      if (!(selling || !!s?.ended)) return item?.remove();
      if (!item) {
        item = (faqTpl.content.cloneNode(true) as DocumentFragment).firstElementChild as HTMLElement;
        faqTpl.after(item);
        const q = item.querySelector('.faq-q');
        q?.addEventListener('click', () => toggle(q));
        item.querySelector('.faq-founder-link')?.addEventListener('click', () => rememberCta('faq'));
      }
      item.querySelector<HTMLElement>('[data-founder-faq-open]')!.hidden = !selling;
      item.querySelector<HTMLElement>('[data-founder-faq-ended]')!.hidden = selling;
    });
  }

  document.querySelectorAll('.faq-q').forEach((btn) => {
    btn.addEventListener('click', () => toggle(btn));
  });
</script>
