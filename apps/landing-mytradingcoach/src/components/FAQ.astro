---
// Texte : src/data/faq.ts (même source que le JSON-LD FAQPage de la home).
import { FAQ } from '../data/faq';
---

<section class="faq-section" id="faq">
  <div class="wrap">
    <div class="reveal head">
      <span class="sec-label">Questions fréquentes</span>
      <h2>Tout ce que tu veux <em>savoir</em></h2>
    </div>
    <div class="faq-list reveal">
      {FAQ.map((item, i) => (
        <div class={i === 0 ? 'faq-item open' : 'faq-item'}>
          {/* `aria-controls` lie la question a sa reponse : sans lui, un lecteur d'ecran
              annonce « developpe » sans dire ce qui s'ouvre, ni ou aller le lire. */}
          <button class="faq-q" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-a-${i}`}>
            {item.question}
            <span class="faq-arrow" aria-hidden="true">▼</span>
          </button>
          <div class="faq-a" id={`faq-a-${i}`} role="region">{item.answer}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .head { text-align: center; }
  .faq-section {
    background: var(--bg2);
    border-top: 1px solid var(--b);
  }

  .faq-list {
    max-width: 720px;
    margin: 40px auto 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .faq-item { border-bottom: 1px solid var(--b); }

  .faq-q {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    cursor: pointer;
    font-size: 15px;
    font-weight: 500;
    color: var(--txt);
    transition: color .15s;
    gap: 16px;
    user-select: none;
    background: none;
    border: none;
    font-family: var(--disp);
    text-align: left;
  }
  .faq-q:hover { color: var(--blue2); }

  .faq-arrow {
    color: var(--txt3);
    font-size: 12px;
    flex-shrink: 0;
    transition: transform .2s;
  }
  .faq-item.open .faq-arrow { transform: rotate(180deg); }

  .faq-a {
    font-size: 14px;
    color: var(--txt2);
    line-height: 1.7;
    padding-bottom: 16px;
    display: none;
    font-weight: 300;
  }
  .faq-item.open .faq-a { display: block; }

  @media (max-width: 768px) {
    .faq-section { padding: 64px 16px; }
    .faq-q { font-size: 14px; }
  }

  @media (max-width: 480px) {
    .faq-section { padding: 56px 14px; }
  }
</style>

<script>
  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const wasOpen = item?.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(x => {
        x.classList.remove('open');
        x.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
      });
      if (!wasOpen && item) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
