---
import { APP_URL } from '../config';
import FounderBanner from './FounderBanner.astro';

// stickyCta : false sur les pages où un CTA de conversion n'a pas sa place (ex. /disclaimer).
// home : true sur l'ancienne accueil (/accueil), dont le menu et le bandeau restent sur la page même.
// Ailleurs, l'accueil du site est /prop-firm (redirection temporaire de `/`, 2026-11-08) : logo,
// ancres et bandeau fondateur y pointent directement, sans détour par la 302.
const { stickyCta = true, home = false } = Astro.props;
const links = home
  ? [
      { href: '#journee', label: 'Comment ça marche' },
      { href: '#features', label: 'Fonctionnalités' },
      { href: '#pricing', label: 'Tarifs' },
      { href: '#faq', label: 'FAQ' },
    ]
  : [
      { href: '/prop-firm#comment', label: 'Comment ça marche' },
      { href: '/prop-firm#prop-firms', label: 'Fonctionnalités' },
      { href: '/prop-firm#tarifs', label: 'Tarifs' },
    ];
---
<FounderBanner href={home ? '#pricing' : '/prop-firm#tarifs'} />
<div class="nav-bar">
  <a href="/prop-firm" class="nav-logo">
    <img src="/icon/logo-navbar.svg" alt="MyTradingCoach : Journal de trading IA" height="32" style="display:block" />
  </a>

  <nav id="nav-links" class="nav-links">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href={`${APP_URL}/login`} class="nav-login-link">Connexion</a>
    <a href={`${APP_URL}/register`} class="nav-cta" data-ga-event="cta_signup" data-ga-place="nav">Commencer gratuitement →</a>
  </nav>

  <button
    id="nav-toggle"
    class="nav-hamburger"
    aria-label="Ouvrir le menu"
    aria-expanded="false"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
</div>

{stickyCta && (
  <a href={`${APP_URL}/register`} class="nav-sticky-cta" data-ga-event="cta_signup" data-ga-place="nav">
    Commencer gratuitement →
  </a>
)}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('nav-toggle');
    const navLinks = document.getElementById('nav-links');
    const body = document.body;

    const sticky = document.querySelector<HTMLElement>('.nav-sticky-cta');

    // La barre sticky double le CTA du hero tant que celui-ci est à l'écran.
    const heroCta = document.querySelector('.hero-cta-main');
    if (sticky && heroCta) {
      new IntersectionObserver(([entry]) => {
        sticky.classList.toggle('behind-hero', entry.isIntersecting);
      }).observe(heroCta);
    }

    if (!toggle || !navLinks) return;

    toggle.addEventListener('click', () => {
      const isOpen = navLinks.classList.contains('open');
      if (isOpen) {
        navLinks.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        body.style.overflow = '';
        body.classList.remove('nav-open');
      } else {
        navLinks.classList.add('open');
        toggle.setAttribute('aria-expanded', 'true');
        body.style.overflow = 'hidden';
        body.classList.add('nav-open');
      }
    });

    navLinks.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        navLinks.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        body.style.overflow = '';
        body.classList.remove('nav-open');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navLinks.classList.contains('open')) {
        navLinks.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        body.style.overflow = '';
        body.classList.remove('nav-open');
      }
    });
  });
</script>

<style>
  .nav-bar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 200;
    height: 60px;
    padding: 0 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(6,9,15,0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--b);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--txt);
    flex-shrink: 0;
    z-index: 201;
  }

  /* ── Desktop nav ── (à partir de 1024 px : en tablette, les 5 liens + le CTA ne tiennent pas) */
  @media (min-width: 1024px) {
    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .nav-links a {
      font-size: 13px;
      color: var(--txt2);
      text-decoration: none;
      transition: color .2s;
    }

    .nav-links a:hover { color: var(--txt); }

    .nav-cta {
      background: var(--blue) !important;
      color: #fff !important;
      padding: 7px 16px;
      border-radius: 7px;
      font-weight: 500 !important;
      font-size: 13px !important;
      box-shadow: 0 0 20px rgba(59,130,246,.3);
      transition: background .2s, box-shadow .2s, transform .2s !important;
    }

    .nav-cta:hover {
      background: var(--blue2) !important;
      box-shadow: 0 0 30px rgba(59,130,246,.5) !important;
      transform: translateY(-1px);
    }

    .nav-hamburger {
      display: none;
    }
  }

  /* ── Mobile et tablette : menu hamburger ── */
  @media (max-width: 1023px) {
    /* État fermé : caché */
    .nav-links {
      display: none !important;
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      z-index: 9999 !important;
      background-color: var(--bg2) !important;
      background: var(--bg2) !important;
      opacity: 1 !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 40px !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    /* État ouvert */
    .nav-links.open {
      display: flex !important;
    }

    /* Liens dans le menu */
    .nav-links a {
      font-size: 22px !important;
      font-weight: 600 !important;
      color: #e2eaf5 !important;
      text-decoration: none !important;
      font-family: 'Inter', sans-serif !important;
    }

    /* Bouton CTA dans le menu */
    .nav-links .nav-cta,
    .nav-links a[href*="register"] {
      background: #3b82f6 !important;
      color: #fff !important;
      padding: 12px 28px !important;
      border-radius: 8px !important;
      font-size: 16px !important;
    }

    /* Hamburger visible */
    .nav-hamburger {
      display: flex !important;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      z-index: 10000;
      position: relative;
    }

    .nav-hamburger span {
      display: block;
      width: 22px;
      height: 2px;
      background: #e2eaf5;
      border-radius: 2px;
      transition: transform 0.25s ease, opacity 0.25s ease;
    }

    /* Croix quand ouvert */
    .nav-hamburger[aria-expanded="true"] span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-hamburger[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }
    .nav-hamburger[aria-expanded="true"] span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  .nav-sticky-cta { display: none; }

  @media (max-width: 767px) {
    .nav-sticky-cta {
      display: block;
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: var(--blue);
      color: white;
      text-align: center;
      padding: 14px;
      font-size: 15px; font-weight: 700;
      text-decoration: none;
      z-index: 999;
      box-shadow: 0 -4px 20px rgba(0,0,0,.4);
      transition: transform .2s ease;
    }
    /* Masquée quand le CTA du hero est visible ou que le menu (qui a son propre CTA) est ouvert. */
    .nav-sticky-cta.behind-hero,
    :global(body.nav-open) .nav-sticky-cta {
      transform: translateY(100%);
      pointer-events: none;
    }
  }
</style>

<style is:global>
  @media (max-width: 767px) {
    body { padding-bottom: 56px; }
  }
</style>
