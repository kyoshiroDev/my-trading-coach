---
import { API_URL, FEATURES } from '../config';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Moments from '../components/Moments.astro';
import Problem from '../components/Problem.astro';
import DayTimeline from '../components/DayTimeline.astro';
import Features from '../components/Features.astro';
import Showcase from '../components/Showcase.astro';
import CoachIA from '../components/CoachIA.astro';
import Debrief from '../components/Debrief.astro';
import MultiComptes from '../components/MultiComptes.astro';
import Compare from '../components/Compare.astro';
import Pricing from '../components/Pricing.astro';
import Referral from '../components/Referral.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import { HOME_SCHEMA } from '../data/schema';

const ARTICLES = [
  {
    slug: "revenge-trading",
    title: "Revenge Trading : Comment l'Identifier et l'Arrêter",
    desc: "Le revenge trading détruit les comptes. Repère ce comportement et les techniques pour l'éliminer.",
    tags: ["Psychologie", "Discipline"],
    date: "10 Avr 2026",
  },
  {
    slug: "win-rate-trading",
    title: "Win Rate en Trading : Ce que Votre Taux de Réussite Cache",
    desc: "Un win rate de 40 % peut être plus rentable qu'un win rate de 70 %. Comprendre ce chiffre change tout.",
    tags: ["Analyse", "Performance"],
    date: "12 Avr 2026",
  },
  {
    slug: "psychologie-trading",
    title: "Psychologie du Trading : Les 7 Biais qui Détruisent vos Trades",
    desc: "Biais de confirmation, excès de confiance, aversion aux pertes : identifier ces biais est la première étape.",
    tags: ["Psychologie", "Biais cognitifs"],
    date: "15 Avr 2026",
  },
];

// Compteur de traders : fetch au build (SEO + valeur initiale), fallback si API down.
const FALLBACK_TRADERS = 14;
let traders = FALLBACK_TRADERS;
try {
  const res = await fetch(`${API_URL}/public/stats`);
  if (res.ok) {
    const j = await res.json();
    if (typeof j?.data?.traders === 'number') traders = j.data.traders;
  }
} catch {
  // API injoignable au build → on garde le fallback
}
---

<Base
  title="Journal de trading IA et coach | MyTradingCoach"
  description="Journal de trading IA : il te prépare avant ta session, t'accompagne en live et débrieffe ta journée. Crypto, Futures, Forex. Gratuit sans CB."
  canonical="https://www.mytradingcoach.app/"
  ogUrl="https://www.mytradingcoach.app/"
  schema={HOME_SCHEMA}
>
  <Nav />
  <Hero traders={traders} />
  <Moments />
  <Problem />
  <DayTimeline />
  <Features />
  <!-- L'app en vrai (maquettes produit), puis le coach IA et le débrief : décision D2 de l'audit. -->
  <Showcase />
  <CoachIA />
  <Debrief />
  {FEATURES.multiAccounts && <MultiComptes />}
  <Compare />
  <Pricing />
  {FEATURES.referral && <Referral />}
  <Testimonials traders={traders} />
  <FAQ />
  <CtaFinal />

  <!-- Section blog : liens internes pour le SEO -->
  <section class="blog-teaser">
    <div class="wrap">
      <div class="blog-head">
        <div>
          <span class="blog-label">Blog</span>
          <h2 class="blog-title">
            Ressources pour <em>mieux trader</em>
          </h2>
        </div>
        <a href="/blog" class="blog-all">
          Voir tous les articles →
        </a>
      </div>

      <div class="blog-grid">
        {ARTICLES.map((article) => (
          <a href={`/blog/${article.slug}`} class="blog-card">
            <div class="blog-tags">
              {article.tags.map((tag) => (
                <span class="blog-tag">
                  {tag}
                </span>
              ))}
            </div>
            <h3>
              {article.title}
            </h3>
            <p>
              {article.desc}
            </p>
            <span class="blog-date">{article.date}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />

  <!-- Rafraîchit le compteur de traders en live (la valeur du build sert de fallback). -->
  <script>
    const API = import.meta.env.PUBLIC_API_URL ?? 'https://api.mytradingcoach.app/api';
    fetch(`${API}/public/stats`)
      .then((r) => (r.ok ? r.json() : null))
      .then((j) => {
        const n = j?.data?.traders;
        if (typeof n === 'number') {
          document
            .querySelectorAll('[data-traders-count]')
            .forEach((el) => { el.textContent = String(n); });
        }
      })
      .catch(() => { /* API down → on garde la valeur du build */ });
  </script>
</Base>

<style>
.blog-teaser { padding: 80px 5%; background: var(--bg2); border-top: 1px solid var(--b); }
.blog-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 40px; }
.blog-label {
  font-size: 11px; font-family: var(--mono); color: var(--pulse); letter-spacing: 2px;
  text-transform: uppercase; display: block; margin-bottom: 10px;
}
.blog-title {
  font-family: var(--disp); font-size: clamp(24px, 4vw, 36px); font-weight: 700;
  letter-spacing: -0.5px; color: var(--txt); margin: 0;
}
.blog-title em { font-style: italic; font-family: var(--body); font-weight: 300; color: var(--blue2); }
.blog-all {
  font-size: 13px; color: var(--blue2); text-decoration: none; font-family: var(--mono);
  white-space: nowrap; flex-shrink: 0;
}
.blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.blog-card {
  background: var(--card); border: 1px solid var(--b); border-radius: 14px; padding: 24px;
  text-decoration: none; display: flex; flex-direction: column; gap: 12px; transition: border-color .2s;
}
.blog-card:hover { border-color: rgba(99, 155, 255, .3); }
.blog-tags { display: flex; gap: 6px; flex-wrap: wrap; }
.blog-tag {
  font-size: 10px; font-family: var(--mono); color: var(--pulse); background: rgba(34, 211, 238, .07);
  border: 1px solid rgba(34, 211, 238, .2); padding: 2px 8px; border-radius: 100px;
}
.blog-card h3 { font-family: var(--disp); font-size: 16px; font-weight: 700; color: var(--txt); margin: 0; line-height: 1.3; }
.blog-card p { font-size: 13px; color: var(--txt2); margin: 0; line-height: 1.6; font-weight: 300; flex: 1; }
.blog-date { font-size: 11px; color: var(--txt3); font-family: var(--mono); }

@media (max-width: 767px) {
  .blog-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }
}
</style>
