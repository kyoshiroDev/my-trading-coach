---
// /prop-firm : landing épurée pour les traders futures en prop firm (test publicitaire, oct. 2026).
// Maquettes : maquettes/maquette-landing-prop-firm-{mobile,desktop}.html (gitignorées, locales).
// Page à part : noindex, hors sitemap et hors navigation, seuls ceux qui ont le lien (pub) y
// arrivent. Rien d'autre n'en dépend : la supprimer = ce fichier + components/prop-firm-page/ +
// la ligne du filtre sitemap (astro.config.mjs). Même layout que la home : script d'acquisition
// (UTM, /public/visit, cta_click), bandeau cookies, mode interne. Pas d'emoji hors footer.
import { PROP_FIRM_CATALOG_FILES } from '@mtc/shared';
import { APP_URL } from '../config';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import NinjaTraderTrust from '../components/NinjaTraderTrust.astro';
import PfHeader from '../components/prop-firm-page/PfHeader.astro';
import PfRules from '../components/prop-firm-page/PfRules.astro';
import PfPricing from '../components/prop-firm-page/PfPricing.astro';
import { ORGANIZATION } from '../data/schema';
import { TEMOIGNAGES } from '../data/temoignages';
import { founderOpenAtBuild } from '../lib/founder-build';

const firmCount = PROP_FIRM_CATALOG_FILES.length;
const founderOpen = await founderOpenAtBuild();
const register = `${APP_URL}/register`;

const steps = [
  { title: 'Connecte Tradovate', text: 'En lecture seule. MyTradingCoach ne voit jamais ton mot de passe et ne peut passer aucun ordre.' },
  { title: 'Choisis ta firme et ton plan', text: 'Apex, Topstep, Tradeify… Les règles officielles sont déjà prêtes.' },
  { title: "Trade comme d'habitude", text: 'Tu vois ta marge, ton objectif et ton prochain payout bouger à chaque trade.' },
];
const changes = [
  { title: 'En français, de A à Z', text: "L'app, le coach IA, les analyses et le support." },
  { title: 'Les règles exactes de ta firme', text: 'Pas un drawdown générique : celui de ton plan, relevé à la source et daté.' },
  { title: 'Pendant ta séance, pas le soir', text: "Tu vois ce qu'il te reste au moment où tu peux encore agir." },
];
const extras = [
  { title: 'Un coach IA qui connaît ta stratégie', text: 'Il prépare ta séance, repère tes erreurs qui reviennent et fait le débrief de ta semaine.' },
  { title: 'Calendrier économique filtré', text: 'Seulement les annonces qui touchent tes actifs, analysées quand elles tombent.' },
  { title: 'Journal complet', text: 'Émotions, setups et notes, pour comprendre ce qui marche vraiment pour toi.' },
  { title: 'Pas sur Tradovate ?', text: 'Importe tes trades en CSV : Binance, Bybit, MetaTrader 4/5, IBKR et MEXC sont reconnus d’office. Autre plateforme : l’import IA lit ton fichier (Premium).' },
];
// Réponses alignées sur la FAQ de la home (src/data/faq.ts) et plans.md.
const faq = [
  { q: "C'est vraiment gratuit ?", a: "Oui. Le plan Gratuit n'a pas de limite de durée et ne demande aucune carte bancaire." },
  { q: 'MyTradingCoach peut-il toucher à mon compte ?', a: "Non. La connexion est en lecture seule : aucun ordre, aucun mouvement d'argent." },
  { q: 'Je ne suis pas sur Tradovate.', a: 'Tu peux importer tes trades en CSV. Binance, Bybit, MetaTrader 4/5, IBKR et MEXC sont reconnus automatiquement, en gratuit. Pour une autre plateforme, l’import IA lit ton fichier tel quel : il est réservé au Premium.' },
  { q: 'Le calcul remplace la plateforme de ma firme ?', a: 'Non, il est indicatif : la plateforme de ta firme fait toujours foi.' },
];
---

<Base
  title="MyTradingCoach · Ne grille plus ton compte prop firm"
  description={`Trader futures en prop firm : connecte Tradovate et vois en direct ce qu'il te reste avant de perdre ton compte. Règles de ${firmCount} prop firms. Gratuit, sans carte.`}
  canonical="https://www.mytradingcoach.app/prop-firm"
  noindex
  schema={[ORGANIZATION]}
>
  <PfHeader />

  <main class="pfp">
    {/* 1. Haut de page + carte d'exemple (dessous en mobile, à droite sur ordinateur). */}
    <section class="pf-hero">
      <div class="pf-hero-copy">
        <span class="pf-eyebrow">Pour les traders futures en prop firm</span>
        <h1>Ne grille plus ton compte <span class="pf-accent">prop firm.</span></h1>
        <p class="pf-lead">Connecte ton compte Tradovate : MyTradingCoach te montre en direct combien il te reste avant de perdre ton compte.</p>
        <ul class="pf-checks">
          <li><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><polyline points="4 12 10 18 20 6" /></svg>Tes trades arrivent tout seuls</li>
          <li><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><polyline points="4 12 10 18 20 6" /></svg>Ta marge restante, en direct</li>
          <li><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><polyline points="4 12 10 18 20 6" /></svg>Les règles de {firmCount} prop firms, au plan près</li>
        </ul>
        <div class="pf-hero-ctas">
          <a href={register} class="pf-btn" data-ga-event="cta_signup" data-ga-place="pf-hero">Commencer gratuitement</a>
          <a href={`${APP_URL}/demo`} class="pf-demo" data-ga-event="cta_demo" data-ga-place="pf-hero">Voir la démo</a>
        </div>
        <p class="pf-reassure">Gratuit, sans carte bancaire · Lecture seule, aucun ordre passé</p>
        {/* Seul emoji de la page hors footer (demande du 18/10). NinjaTrader : formulation factuelle
            de la clause 17 ; le logo est dans le bloc NinjaTraderTrust de `.pf-hero-side`. */}
        <p class="pf-trustline">🇫🇷 Fait en France · Indépendant · Sans publicité · Référencé dans l'écosystème NinjaTrader</p>
      </div>

      <div class="pf-hero-side">
        <figure class="pf-example">
          <div class="pf-ex-card">
            <div class="pf-ex-top"><span class="pf-ex-name">Éval Apex 50K</span><span class="pf-ex-live">En séance</span></div>
            <div class="pf-ex-left">
              <span class="pf-ex-label">Il te reste avant la limite</span>
              <span class="pf-ex-amt">480 $</span>
            </div>
            <div class="pf-ex-bar" aria-hidden="true"><span></span></div>
            <dl class="pf-ex-tiles">
              <div><dt>Objectif restant</dt><dd>1 240 $</dd></div>
              <div class="pf-ex-loss"><dt>Perte du jour</dt><dd>−520 $</dd></div>
              <div><dt>Trades du jour</dt><dd>4</dd></div>
            </dl>
          </div>
          <figcaption>Exemple avec des données de démonstration</figcaption>
        </figure>
        {/* Wordmark NinjaTrader cliquable dans le premier écran sur ordinateur (sous la carte), juste
            après lui en mobile (demande NinjaTrader 21/10). */}
        <NinjaTraderTrust />
      </div>
    </section>

    {/* 4. Prêt en 2 minutes */}
    <section class="pf-band pf-steps" id="comment">
      <div class="pf-in">
        <h2 class="pf-h2 pf-center">Prêt en 2 minutes</h2>
        <ol class="pf-steps-list">
          {steps.map((s, i) => (
            <li>
              <span class="pf-step-n">{i + 1}</span>
              <div><h3>{s.title}</h3><p>{s.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* 5. Sélecteur firm → plan → phase */}
    <PfRules />

    {/* 6. Ce qui change */}
    <section class="pf-sec">
      <div class="pf-in">
        <h2 class="pf-h2 pf-center">Ce qui change des journaux classiques</h2>
        <div class="pf-changes">
          {changes.map((c) => (
            <div class="pf-change"><h3>{c.title}</h3><p>{c.text}</p></div>
          ))}
        </div>
      </div>
    </section>

    {/* 7. Le tilt */}
    <section class="pf-band pf-tilt">
      <div class="pf-in pf-narrow">
        <h2 class="pf-h2">On perd rarement son éval sur un seul trade.</h2>
        <p>On la perd sur les deux ou trois trades « pour se refaire » juste après. Quand tu vois ce qu'il te reste, tu t'arrêtes avant.</p>
      </div>
    </section>

    {/* 8. Témoignages : seulement s'il y en a de RÉELS (src/data/temoignages.ts, vide aujourd'hui). */}
    {TEMOIGNAGES.length > 0 && (
      <section class="pf-band pf-quotes">
        <div class="pf-in">
          <h2 class="pf-h2 pf-center">Ils l'utilisent déjà</h2>
          <div class="pf-quotes-grid">
            {TEMOIGNAGES.map((t) => (
              <figure class="pf-quote">
                <blockquote>{t.citation}</blockquote>
                <figcaption>
                  <span class="pf-avatar" aria-hidden="true">{t.nom.charAt(0).toUpperCase()}</span>
                  <span class="pf-who"><span class="pf-who-name">{t.nom}</span><span class="pf-who-role">{t.profil}</span></span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* 9. Et aussi (c'est ici, et seulement ici, que crypto et forex apparaissent). */}
    <section class="pf-sec pf-extras">
      <div class="pf-in pf-extras-grid">
        <div>
          <h2 class="pf-h2">Et aussi</h2>
          <div class="pf-extras-list">
            {extras.map((e) => (
              <div class="pf-extra"><h3>{e.title}</h3><p>{e.text}</p></div>
            ))}
          </div>
        </div>
        <figure class="pf-shot">
          <img
            src="/showcase/app-ai.webp"
            width="2424"
            height="1284"
            loading="lazy"
            decoding="async"
            alt="Capture réelle de MyTradingCoach : analyses du coach IA sur les habitudes de trading."
          />
          <figcaption>Capture réelle · compte de démonstration</figcaption>
        </figure>
      </div>
    </section>

    {/* 10. Tarifs */}
    <PfPricing founderOpen={founderOpen} />

    {/* 11. Confiance : formulation factuelle (clause 17 NinjaTrader), jamais « partenaire officiel ». */}
    <section class="pf-sec pf-trust">
      <div class="pf-in pf-narrow">
        <h2 class="pf-h2 pf-h2-sm">Pourquoi tu peux nous faire confiance</h2>
        <ul class="pf-trust-list">
          <li><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>Lecture seule : aucun ordre ne peut être passé depuis MyTradingCoach</li>
          <li><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="9" /><polyline points="8 12 11 15 16 9" /></svg>Référencé dans l'écosystème NinjaTrader</li>
          <li><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" /></svg>Données hébergées en France, jamais vendues</li>
          <li><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 5h16v14H4z" /><line x1="8" y1="10" x2="16" y2="10" /><line x1="8" y1="14" x2="13" y2="14" /></svg>Règles prop firm sourcées et datées</li>
        </ul>
      </div>
    </section>

    {/* 12. FAQ courte */}
    <section class="pf-band pf-faq">
      <div class="pf-in pf-narrow">
        <h2 class="pf-h2 pf-h2-sm">Questions fréquentes</h2>
        <dl class="pf-faq-list">
          {faq.map((f) => (
            <div class="pf-faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    {/* 13. Dernier appel */}
    <section class="pf-sec pf-final">
      <div class="pf-in pf-narrow">
        <h2 class="pf-h2">Sache toujours ce qu'il te reste.</h2>
        <a href={register} class="pf-btn" data-ga-event="cta_signup" data-ga-place="pf-final">Commencer gratuitement</a>
        <span class="pf-reassure">Gratuit, sans carte bancaire</span>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* Utilitaires de la page, partagés avec ses composants (prop-firm-page/) : :global() bornés à .pfp. */
  .pfp :global(.pf-eyebrow) {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--pulse);
  }
  .pfp :global(.pf-h2) {
    margin: 0;
    font-family: var(--disp);
    font-size: 40px;
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: -1px;
  }
  .pfp :global(.pf-h2-sm) { font-size: 32px; letter-spacing: -0.6px; }

  .pfp { position: relative; z-index: 1; }
  .pfp section { padding: 88px 20px; }
  .pf-in { max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 40px; }
  .pf-narrow { max-width: 820px; }
  .pf-center { text-align: center; }
  .pf-band { background: var(--bg2); border-top: 1px solid var(--b); border-bottom: 1px solid var(--b); }
  /* Ancres sous l'en-tête fixe (60 px) ; 92 px quand le bandeau de l'offre est affiché (FounderBanner). */
  :global(html) { scroll-padding-top: 60px; }
  h3 { margin: 0; font-family: var(--body); font-size: 20px; font-weight: 600; line-height: 1.35; }
  .pfp p { margin: 0; }

  /* ── Haut de page ── */
  .pfp .pf-hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 88px 20px 88px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px;
    align-items: center;
  }
  .pf-hero-copy { display: flex; flex-direction: column; gap: 24px; }
  h1 {
    margin: 0;
    font-family: var(--disp);
    font-size: 64px;
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: -2px;
  }
  .pf-accent { color: var(--blue2); }
  .pf-lead { font-size: 20px; line-height: 1.55; color: var(--txt2); max-width: 520px; }
  .pf-checks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .pf-checks li { display: flex; gap: 12px; align-items: center; font-size: 17px; }
  .pf-checks svg {
    flex: none;
    fill: none;
    stroke: var(--blue2);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pf-hero-ctas { display: flex; align-items: center; gap: 20px; margin-top: 8px; }
  .pf-btn {
    display: inline-block;
    text-align: center;
    text-decoration: none;
    background: var(--blue);
    color: #fff;
    font-family: var(--disp);
    font-size: 18px;
    font-weight: 700;
    padding: 18px 30px;
    border-radius: 14px;
    box-shadow: 0 0 32px rgba(59, 130, 246, 0.35);
    transition: background 0.2s, transform 0.2s;
  }
  .pf-btn:hover { background: var(--blue2); transform: translateY(-2px); }
  .pf-btn:focus-visible,
  .pf-demo:focus-visible { outline: 2px solid var(--blue2); outline-offset: 3px; }
  .pf-demo { font-size: 16px; color: var(--blue2); padding: 10px 4px; }
  .pf-demo:hover { color: var(--txt); }
  .pf-reassure { font-size: 14px; color: var(--txt2); }
  .pf-trustline { font-size: 12.5px; line-height: 1.5; color: var(--txt3); margin-top: -12px; }

  /* Carte d'exemple : marge restante en jaune (alerte), perte en rouge (perte), cf. design.md. */
  /* Carte d'exemple + bloc NinjaTrader : sur ordinateur, le logo reste dans le premier écran. */
  .pf-hero-side { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .pf-hero-side :global(.nt-trust) { align-self: center; }
  .pf-example { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .pf-ex-card {
    background: var(--card);
    border: 1px solid var(--b2);
    border-radius: 22px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .pf-ex-top { display: flex; justify-content: space-between; align-items: baseline; }
  .pf-ex-name { font-size: 20px; font-weight: 600; }
  .pf-ex-live { font-family: var(--mono); font-size: 12px; color: var(--pulse); }
  .pf-ex-left { display: flex; flex-direction: column; gap: 8px; }
  .pf-ex-label,
  .pf-ex-tiles dt { font-family: var(--mono); font-size: 12px; letter-spacing: 1px; text-transform: uppercase; color: var(--txt3); }
  .pf-ex-tiles dt { letter-spacing: 0.4px; text-transform: none; font-family: var(--body); font-size: 13px; color: var(--txt2); }
  .pf-ex-amt {
    font-family: var(--mono);
    font-size: 72px;
    font-weight: 500;
    line-height: 1;
    color: var(--yel);
    font-variant-numeric: tabular-nums;
  }
  .pf-ex-bar { height: 12px; border-radius: 6px; background: var(--bg3); overflow: hidden; }
  .pf-ex-bar span { display: block; width: 24%; height: 100%; background: var(--yel); border-radius: 6px; }
  .pf-ex-tiles { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .pf-ex-tiles div { background: var(--bg3); border-radius: 12px; padding: 14px; }
  .pf-ex-tiles dd { margin: 0; font-family: var(--mono); font-size: 19px; font-variant-numeric: tabular-nums; }
  .pf-ex-loss dd { color: var(--red); }
  .pf-example figcaption { text-align: center; font-size: 13px; color: var(--txt3); }

  /* ── Étapes ── */
  .pf-steps-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .pf-steps-list li { display: flex; flex-direction: column; gap: 12px; }
  .pf-steps-list li > div { display: flex; flex-direction: column; gap: 8px; }
  .pf-steps-list p { font-size: 16px; line-height: 1.55; color: var(--txt2); }
  .pf-step-n {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(96, 165, 250, 0.5);
    color: var(--blue2);
    font-family: var(--mono);
    font-size: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Ce qui change ── */
  .pf-changes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .pf-change { display: flex; flex-direction: column; gap: 8px; padding-left: 16px; border-left: 2px solid var(--pulse); }
  .pf-change p,
  .pf-extra p { font-size: 16px; line-height: 1.55; color: var(--txt2); }

  /* ── Tilt ── */
  .pf-tilt .pf-in { gap: 16px; text-align: center; }
  .pf-tilt p { font-size: 19px; line-height: 1.6; color: var(--txt2); }

  /* ── Témoignages ── */
  .pf-quotes-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .pf-quote {
    margin: 0;
    background: var(--card);
    border: 1px solid var(--b2);
    border-radius: 16px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pf-quote blockquote { margin: 0; font-size: 16px; line-height: 1.55; color: var(--txt); }
  .pf-quote figcaption { display: flex; align-items: center; gap: 12px; }
  .pf-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--card2);
    border: 1px solid var(--b2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
  }
  .pf-who { display: flex; flex-direction: column; }
  .pf-who-name { font-size: 15px; font-weight: 600; }
  .pf-who-role { font-size: 13px; color: var(--txt2); }

  /* ── Et aussi ── */
  .pf-extras-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: center; }
  .pf-extras-list { display: flex; flex-direction: column; margin-top: 18px; }
  .pf-extra { padding: 16px 0; border-bottom: 1px solid var(--b); display: flex; flex-direction: column; gap: 4px; }
  .pf-extra:last-child { border-bottom: 0; }
  .pf-extra h3 { font-size: 17px; }
  .pf-extra p { font-size: 15px; }
  .pf-shot { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .pf-shot img { width: 100%; height: auto; border-radius: 14px; border: 1px solid var(--b2); }
  .pf-shot figcaption { text-align: center; font-size: 13px; color: var(--txt3); }

  /* ── Confiance ── */
  .pf-trust .pf-in { gap: 24px; }
  .pf-trust-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 32px; }
  .pf-trust-list li { display: flex; gap: 12px; align-items: flex-start; font-size: 16px; line-height: 1.5; }
  .pf-trust-list svg {
    flex: none;
    margin-top: 1px;
    fill: none;
    stroke: var(--blue2);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── FAQ ── */
  .pf-faq .pf-in { gap: 12px; }
  .pf-faq-list { margin: 0; }
  .pf-faq-item { padding: 18px 0; border-bottom: 1px solid var(--b); display: flex; flex-direction: column; gap: 6px; }
  .pf-faq-item:last-child { border-bottom: 0; }
  .pf-faq-item dt { font-size: 17px; font-weight: 600; }
  .pf-faq-item dd { margin: 0; font-size: 16px; line-height: 1.55; color: var(--txt2); }

  /* ── Dernier appel ── */
  .pf-final .pf-in { align-items: center; text-align: center; gap: 20px; }

  /* ── Tablette / mobile ── */
  @media (max-width: 1023px) {
    .pfp .pf-hero { grid-template-columns: minmax(0, 1fr); gap: 40px; }
  }
  @media (max-width: 900px) {
    .pfp :global(.pf-h2) { font-size: 28px; line-height: 1.15; letter-spacing: -0.5px; }
    .pfp :global(.pf-h2-sm) { font-size: 24px; }
    .pfp :global(.pf-eyebrow) { font-size: 11px; letter-spacing: 1.4px; }
    .pfp section { padding: 44px 20px; }
    .pf-in { gap: 22px; }
    .pf-center { text-align: left; }
    h3 { font-size: 17px; }
    .pf-steps-list,
