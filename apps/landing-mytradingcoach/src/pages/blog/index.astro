---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

// Liste générée depuis la collection (src/content/blog), du plus récent au plus ancien.
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    description: post.data.description,
    date: post.data.publishDate.toISOString().slice(0, 10),
    tags: post.data.tags,
  }));
---

<Base
  title="Blog Trading : Conseils et analyses MyTradingCoach"
  description="Conseils de trading, psychologie des marchés et guides pour améliorer votre performance."
  canonical="https://www.mytradingcoach.app/blog"
  ogUrl="https://www.mytradingcoach.app/blog"
>
  <Nav />

  <main class="blog-index">
    <div class="blog-header">
      <p class="blog-label">Blog</p>
      <h1 class="blog-title">Articles sur le trading</h1>
      <p class="blog-desc">
        Psychologie, méthodes, analyse de performance : pour progresser en tant que trader.
      </p>
    </div>

    <div class="blog-list">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="blog-card">
          <div class="card-tags">
            {post.tags.map(tag => (
              <span class="card-tag">{tag}</span>
            ))}
          </div>
          <h2 class="card-title">{post.title}</h2>
          <p class="card-desc">{post.description}</p>
          <div class="card-footer">
            <span class="card-date">
              {new Date(post.date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
            <span class="card-read">Lire →</span>
          </div>
        </a>
      ))}
    </div>
  </main>

  <Footer />
</Base>

<style>
  .blog-index {
    max-width: 56rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .blog-header {
    margin-bottom: 3rem;
  }

  .blog-label {
    font-size: 0.875rem;
    color: var(--blue2);
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .blog-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0 0 1rem;
    color: var(--txt);
    font-family: var(--disp);
    letter-spacing: -0.5px;
  }

  .blog-desc {
    color: var(--txt2);
    font-size: 1rem;
    max-width: 32rem;
    margin: 0;
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ── Card link reset ── */
  .blog-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--b);
    border-radius: 1rem;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }

  .blog-card:visited {
    color: inherit;
  }

  .blog-card:hover {
    border-color: var(--blue2);
    color: inherit;
  }

  /* ── Tags ── */
  .card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .card-tag {
    background: var(--card2);
    color: var(--txt3);
    padding: 0.125rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-family: var(--mono);
  }

  /* ── Title ── */
  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--txt);
    font-family: var(--disp);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  /* ── Description ── */
  .card-desc {
    color: var(--txt2);
    font-size: 0.9375rem;
    margin: 0 0 1rem;
    line-height: 1.6;
  }

  /* ── Footer row ── */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-date {
    font-size: 0.8125rem;
    color: var(--txt3);
    font-family: var(--mono);
  }

  .card-read {
    color: var(--blue2);
    font-size: 0.875rem;
  }
</style>
