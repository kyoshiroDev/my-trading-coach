---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    slug: 'evaluer-qualite-execution-trade',
    title: "Évaluer la qualité d'exécution de tes trades (pas juste le résultat)",
    description: "Un trade gagnant peut être mal exécuté, un perdant bien joué. Comment séparer le résultat de la qualité d'exécution : stop, ratio, émotion, taille.",
    date: '2026-07-26',
    tags: ['exécution', 'discipline', 'note de trade'],
  },
  {
    slug: 'calendrier-economique-gratuit-trading',
    title: "Calendrier économique gratuit : t'en servir sans te faire surprendre",
    description: "À quoi sert un calendrier économique quand on trade (NFP, FOMC, CPI), comment l'utiliser avant la séance, et pourquoi un calendrier générique ne suffit pas.",
    date: '2026-07-23',
    tags: ['calendrier économique', 'news', 'gratuit'],
  },
  {
    slug: 'journal-trading-gratuit',
    title: "Un journal de trading gratuit, vraiment gratuit (et en français)",
    description: "La plupart des journaux 'gratuits' te bloquent à 30 trades ou t'espionnent. Ce qu'un vrai plan gratuit devrait offrir, et par où commencer.",
    date: '2026-07-20',
    tags: ['journal de trading', 'gratuit', 'débuter'],
  },
  {
    slug: 'win-rate-break-even',
    title: "Ton win rate est peut-être faux (à cause des break-even)",
    description: "La plupart des traders comptent mal leur win rate à cause des trades break-even. Voici comment le calculer correctement et pourquoi ça change ta lecture.",
    date: '2026-07-18',
    tags: ['win rate', 'break-even', 'statistiques', 'journal de trading'],
  },
  {
    slug: 'meilleur-journal-trading-prop-firm',
    title: "Choisir un journal de trading quand on est en prop firm",
    description: "Les critères qui comptent vraiment pour un journal de trading en prop firm : multi-comptes, règles de drawdown, import broker. Ce qu'un journal généraliste rate.",
    date: '2026-07-16',
    tags: ['prop firm', 'journal de trading', 'ftmo', 'apex'],
  },
  {
    slug: 'importer-trades-tradovate-journal',
    title: "Importer ses trades Tradovate dans un journal (sans se prendre la tête avec les frais)",
    description: "Comment exporter ses trades depuis Tradovate et les importer proprement dans un journal, avec les frais exacts. La méthode que personne n'explique vraiment.",
    date: '2026-07-14',
    tags: ['tradovate', 'import', 'prop firm', 'futures'],
  },
  {
    slug: 'comment-tenir-journal-trading',
    title: "Comment tenir un journal de trading (sans l'abandonner au bout d'une semaine)",
    description: "La vraie difficulté d'un journal de trading n'est pas de le commencer, c'est de le tenir. Quoi noter, à quelle fréquence, et l'erreur qui fait tout lâcher.",
    date: '2026-07-09',
    tags: ['journal de trading', 'méthode', 'discipline'],
  },
  {
    slug: 'journal-trading-debutant',
    title: "Journal de Trading pour Débutants : Guide Complet 2026",
    description: "Tenir un journal de trading qui te fait vraiment progresser : quoi noter, comment analyser tes trades, et avancer plus vite.",
    date: '2026-04-01',
    tags: ['journal de trading', 'débutant', 'guide'],
  },
  {
    slug: 'psychologie-trading',
    title: "Psychologie du Trading : Maîtriser ses Émotions pour Trader Mieux",
    description: "La psychologie pèse sur tes résultats plus que ta technique. Biais cognitifs, gestion des émotions et méthodes pour trader avec discipline.",
    date: '2026-04-05',
    tags: ['psychologie trading', 'biais cognitifs', 'émotions'],
  },
  {
    slug: 'revenge-trading',
    title: "Revenge Trading : Comment l'Identifier et l'Arrêter Définitivement",
    description: "Le revenge trading détruit les comptes. Repère ce comportement toxique et les techniques concrètes pour l'éliminer.",
    date: '2026-04-10',
    tags: ['revenge trading', 'psychologie', 'discipline'],
  },
  {
    slug: 'win-rate-trading',
    title: "Win Rate en Trading : Comment le Calculer et l'Améliorer",
    description: "Le win rate seul ne suffit pas. Calcule ton taux de réussite et comprends pourquoi le ratio R/R est décisif.",
    date: '2026-04-15',
    tags: ['win rate', 'statistiques', 'performance'],
  },
  {
    slug: 'journal-trading-crypto',
    title: "Journal de Trading Crypto : Suivre et Analyser ses Trades BTC/ETH",
    description: "Comment tenir un journal de trading crypto efficace. Suivez vos trades Bitcoin, Ethereum et altcoins pour améliorer vos performances.",
    date: '2026-04-20',
    tags: ['journal trading crypto', 'crypto', 'BTC', 'ETH'],
  },
];
---

<Base
  title="Blog Trading : Conseils et analyses MyTradingCoach"
  description="Conseils de trading, psychologie des marchés et guides pour améliorer votre performance."
  canonical="https://www.mytradingcoach.app/blog"
  ogUrl="https://www.mytradingcoach.app/blog"
>
  <Nav />

  <main class="blog-index">
    <div class="blog-header">
      <p class="blog-label">Blog</p>
      <h1 class="blog-title">Articles sur le trading</h1>
      <p class="blog-desc">
        Psychologie, méthodes, analyse de performance : pour progresser en tant que trader.
      </p>
    </div>

    <div class="blog-list">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="blog-card">
          <div class="card-tags">
            {post.tags.map(tag => (
              <span class="card-tag">{tag}</span>
            ))}
          </div>
          <h2 class="card-title">{post.title}</h2>
          <p class="card-desc">{post.description}</p>
          <div class="card-footer">
            <span class="card-date">
              {new Date(post.date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
            <span class="card-read">Lire →</span>
          </div>
        </a>
      ))}
    </div>
  </main>

  <Footer />
</Base>

<style>
  .blog-index {
    max-width: 56rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .blog-header {
    margin-bottom: 3rem;
  }

  .blog-label {
    font-size: 0.875rem;
    color: var(--blue2);
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .blog-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0 0 1rem;
    color: var(--txt);
    font-family: var(--disp);
    letter-spacing: -0.5px;
  }

  .blog-desc {
    color: var(--txt2);
    font-size: 1rem;
    max-width: 32rem;
    margin: 0;
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ── Card link reset ── */
  .blog-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--b);
    border-radius: 1rem;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }

  .blog-card:visited {
    color: inherit;
  }

  .blog-card:hover {
    border-color: var(--blue2);
    color: inherit;
  }

  /* ── Tags ── */
  .card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .card-tag {
    background: var(--card2);
    color: var(--txt3);
    padding: 0.125rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-family: var(--mono);
  }

  /* ── Title ── */
  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--txt);
    font-family: var(--disp);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  /* ── Description ── */
  .card-desc {
    color: var(--txt2);
    font-size: 0.9375rem;
    margin: 0 0 1rem;
    line-height: 1.6;
  }

  /* ── Footer row ── */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-date {
    font-size: 0.8125rem;
    color: var(--txt3);
    font-family: var(--mono);
  }

  .card-read {
    color: var(--blue2);
    font-size: 0.875rem;
  }
</style>
