---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogUrl?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Page à exclure de l'index (404, pages techniques). `follow` est conservé
   * pour que Google suive quand même les liens sortants de la page. */
  noindex?: boolean;
}

const {
  title = "MyTradingCoach — Journal de trading IA pour progresser",
  description = "Journal de trading intelligent avec coach IA. Identifie tes patterns émotionnels, analyse tes performances et reçois ton Weekly Debrief chaque dimanche. Plan gratuit sans CB, trades illimités — hébergé en France 🇫🇷",
  // trailingSlash: 'never' → le canonical ne doit jamais garder le slash de dossier
  // (`/blog/` servi comme `/blog`). On le retire, sauf pour la racine `/`.
  canonical = `https://www.mytradingcoach.app${Astro.url.pathname.replace(/(.)\/$/, '$1')}`,
  ogUrl = canonical,
  schema,
  noindex = false,
} = Astro.props;

const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- ═══ SEO PRIMARY ═══ -->
  <title>{title}</title>
  <meta name="description" content={description} />
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta name="robots" content={robots} />
  <meta name="author" content="MyTradingCoach" />
  <meta name="geo.region" content="FR" />
  <meta name="language" content="fr" />

  <!-- ═══ OPEN GRAPH ═══ -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:image" content="https://www.mytradingcoach.app/icon/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="MyTradingCoach" />

  <!-- ═══ TWITTER CARD ═══ -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@TradingCoachApp" />
  <meta name="twitter:creator" content="@TradingCoachApp" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://www.mytradingcoach.app/icon/og-image.png" />

  <!-- ═══ SCHEMA.ORG JSON-LD ═══ -->
  {schema ? (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  ) : (
    <script is:inline type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "MyTradingCoach",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "url": "https://www.mytradingcoach.app",
        "description": "Journal de trading intelligent avec coach IA, tracking émotionnel et Weekly Debrief automatique.",
        "inLanguage": "fr",
        "offers": [
          { "@type": "Offer", "name": "Gratuit", "price": "0", "priceCurrency": "EUR", "description": "Trades illimités, journal complet, compagnon de session, calendrier éco IA, news et contexte marché" },
          { "@type": "Offer", "name": "Premium", "price": "49", "priceCurrency": "EUR", "priceSpecification": { "@type": "UnitPriceSpecification", "price": "49", "priceCurrency": "EUR", "unitCode": "MON" }, "description": "Tout le plan Gratuit, plus IA Insights, Chat Coach IA, Weekly Debrief, analytics avancés, comptes illimités et règles prop firm" }
        ],
        "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.8", "ratingCount": "24", "bestRating": "5" },
        "featureList": [
          "Journal de trading avec tracking émotionnel",
          "IA Insights propulsée par Claude",
          "Weekly Debrief automatique chaque dimanche",
          "Analytics avancés : win rate, drawdown, heatmap",
          "Score trader sur 5 axes de progression",
          "Hébergé en France"
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "MyTradingCoach",
        "url": "https://www.mytradingcoach.app",
        "logo": "https://www.mytradingcoach.app/icon/og-image.png",
        "contactPoint": { "@type": "ContactPoint", "email": "hello@mytradingcoach.app", "contactType": "customer support", "availableLanguage": "French" },
        "address": { "@type": "PostalAddress", "addressCountry": "FR" },
        "sameAs": []
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "MyTradingCoach",
        "url": "https://www.mytradingcoach.app",
        "inLanguage": "fr",
        "description": "Journal de trading intelligent avec coach IA pour traders crypto et forex"
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "C'est quoi exactement MyTradingCoach ?",
            "acceptedAnswer": { "@type": "Answer", "text": "MyTradingCoach est un journal de trading intelligent. Tu enregistres tes trades et ton état émotionnel, et l'IA analyse tout ça pour identifier tes patterns comportementaux. Chaque dimanche, tu reçois un debrief complet avec 3 objectifs pour la semaine suivante." }
          },
          {
            "@type": "Question",
            "name": "Quels marchés sont supportés ?",
            "acceptedAnswer": { "@type": "Answer", "text": "MyTradingCoach fonctionne pour tous les marchés : crypto (BTC, ETH, SOL...), forex (EUR/USD, GBP/USD...), actions (AAPL, TSLA...) et indices. Tu saisis les données manuellement." }
          },
          {
            "@type": "Question",
            "name": "L'IA est-elle vraiment personnalisée ?",
            "acceptedAnswer": { "@type": "Answer", "text": "Oui. L'IA analyse uniquement tes données — pas des moyennes génériques. Plus tu l'utilises, plus les insights sont précis. Le debrief hebdomadaire référence tes trades spécifiques avec les heures et les montants réels." }
          },
          {
            "@type": "Question",
            "name": "Combien ça coûte ?",
            "acceptedAnswer": { "@type": "Answer", "text": "Le plan Gratuit suffit pour démarrer : trades illimités, journal, compagnon de session et IA mutualisée (contexte marché, calendrier éco, news). Premium est à 49 €/mois (ou 490 €/an) et ajoute l'IA personnelle : Weekly Debrief, Chat coach, IA Insights, analytics avancés et comptes illimités. Si ça t'évite un seul revenge trade à 300 €, c'est rentabilisé pour des mois." }
          },
          {
            "@type": "Question",
            "name": "Mes données sont-elles sécurisées ?",
            "acceptedAnswer": { "@type": "Answer", "text": "Tes données sont stockées sur des serveurs OVH en France, chiffrées au repos et en transit. Nous ne vendons ni ne partageons jamais tes données de trading. Tu peux exporter ou supprimer ton compte à tout moment." }
          }
        ]
      }
    ])} />
  )}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/logo.svg" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#3b82f6" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" /></noscript>
</head>
<body>
  <slot />
  <script>
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if(e.isIntersecting){ e.target.classList.add('vis'); obs.unobserve(e.target); }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal, .rstag').forEach(el => obs.observe(el));
  </script>

  <!-- Parrainage : capture ?ref, le persiste 30j, et le propage à tous les CTA d'inscription -->
  <script is:inline>
    (function () {
      try {
        var KEY = 'mtc_ref', MAX_AGE = 30 * 24 * 60 * 60 * 1000;
        var fromUrl = (new URL(window.location.href).searchParams.get('ref') || '')
          .trim().toUpperCase();
        if (fromUrl) {
          try { localStorage.setItem(KEY, JSON.stringify({ code: fromUrl, ts: Date.now() })); } catch (e) {}
        }
        var ref = fromUrl;
        if (!ref) {
          try {
            var o = JSON.parse(localStorage.getItem(KEY) || 'null');
            if (o && o.code && (Date.now() - o.ts) < MAX_AGE) ref = o.code;
          } catch (e) {}
        }
        if (!ref) return;
        document.querySelectorAll('a[href*="/register"]').forEach(function (a) {
          try {
            var h = new URL(a.href);
            if (!h.searchParams.get('ref')) { h.searchParams.set('ref', ref); a.href = h.toString(); }
          } catch (e) {}
        });
      } catch (e) {}
    })();
  </script>
</body>
</html>
