---
import '../styles/global.css';
import { DEFAULT_SCHEMA } from '../data/schema';
import { API_URL } from '../config';
import { IN_APP_UA_PATTERN, INTERNAL_STORAGE_KEY } from '@mtc/shared';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogUrl?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Page à exclure de l'index (404, pages techniques). `follow` est conservé
   * pour que Google suive quand même les liens sortants de la page. */
  noindex?: boolean;
}

const {
  title = "MyTradingCoach · Journal de trading IA pour progresser",
  description = "Journal de trading intelligent avec coach IA. Identifie tes patterns émotionnels, analyse tes performances et reçois ton Weekly Debrief chaque dimanche. Plan gratuit sans CB, trades illimités, hébergé en France 🇫🇷",
  // trailingSlash: 'never' → le canonical ne doit jamais garder le slash de dossier
  // (`/blog/` servi comme `/blog`). On le retire, sauf pour la racine `/`.
  canonical = `https://www.mytradingcoach.app${Astro.url.pathname.replace(/(.)\/$/, '$1')}`,
  ogUrl = canonical,
  schema,
  noindex = false,
} = Astro.props;

const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- ═══ SEO PRIMARY ═══ -->
  <title>{title}</title>
  <meta name="description" content={description} />
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta name="robots" content={robots} />
  <meta name="author" content="MyTradingCoach" />
  <meta name="geo.region" content="FR" />
  <meta name="language" content="fr" />

  <!-- ═══ OPEN GRAPH ═══ -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:image" content="https://www.mytradingcoach.app/icon/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="MyTradingCoach" />

  <!-- ═══ TWITTER CARD ═══ -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@TradingCoachApp" />
  <meta name="twitter:creator" content="@TradingCoachApp" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://www.mytradingcoach.app/icon/og-image.png" />

  <!-- ═══ SCHEMA.ORG JSON-LD ═══ (règles : src/data/schema.ts) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema ?? DEFAULT_SCHEMA)} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/logo.svg" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#3b82f6" />

</head>
<body>
  <slot />
  <CookieConsent />
  <Analytics />
  <script>
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if(e.isIntersecting){ e.target.classList.add('vis'); obs.unobserve(e.target); }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal, .rstag').forEach(el => obs.observe(el));
  </script>

  <!-- Parrainage : capture ?ref, le persiste 30j, et le propage à tous les CTA d'inscription -->
  <script is:inline>
    (function () {
      try {
        var KEY = 'mtc_ref', MAX_AGE = 30 * 24 * 60 * 60 * 1000;
        var fromUrl = (new URL(window.location.href).searchParams.get('ref') || '')
          .trim().toUpperCase();
        if (fromUrl) {
          try { localStorage.setItem(KEY, JSON.stringify({ code: fromUrl, ts: Date.now() })); } catch (e) {}
        }
        var ref = fromUrl;
        if (!ref) {
          try {
            var o = JSON.parse(localStorage.getItem(KEY) || 'null');
            if (o && o.code && (Date.now() - o.ts) < MAX_AGE) ref = o.code;
          } catch (e) {}
        }
        if (!ref) return;
        document.querySelectorAll('a[href*="/register"]').forEach(function (a) {
          try {
            var h = new URL(a.href);
            if (!h.searchParams.get('ref')) { h.searchParams.set('ref', ref); a.href = h.toString(); }
          } catch (e) {}
        });
      } catch (e) {}
    })();
  </script>

  <!-- Code partenaire (#525) : ?promo=CODE sur n'importe quelle page (post, bio, DM, e-mail),
       gardé 30 j comme le parrainage et ajouté à tous les CTA d'inscription. Ne remplace PAS la
       source d'acquisition (utm_*) : les deux voyagent ensemble jusqu'à l'app. Format vérifié
       ici, conditions vérifiées par l'API au checkout. -->
  <script is:inline>
    (function () {
      try {
        var KEY = 'mtc_promo', MAX_AGE = 30 * 24 * 60 * 60 * 1000;
        var fromUrl = (new URL(window.location.href).searchParams.get('promo') || '').trim().toUpperCase();
        if (!/^[A-Z0-9_-]{3,20}$/.test(fromUrl)) fromUrl = '';
        if (fromUrl) {
          try { localStorage.setItem(KEY, JSON.stringify({ code: fromUrl, ts: Date.now() })); } catch (e) {}
        }
        var promo = fromUrl;
        if (!promo) {
          try {
            var o = JSON.parse(localStorage.getItem(KEY) || 'null');
            if (o && o.code && (Date.now() - o.ts) < MAX_AGE) promo = o.code;
          } catch (e) {}
        }
        if (!promo) return;
        document.querySelectorAll('a[href*="/register"]').forEach(function (a) {
          try {
            var h = new URL(a.href);
            if (!h.searchParams.get('promo')) { h.searchParams.set('promo', promo); a.href = h.toString(); }
          } catch (e) {}
        });
      } catch (e) {}
    })();
  </script>
  <!-- Acquisition : source de la visite = utm_* du lien, sinon site d'origine (referrer
       externe, medium « referral »), gardée en sessionStorage pour toute la session.
       1) propagée aux CTA d'inscription (→ User.acquisition* à l'inscription) ;
       2) comptée par l'API (POST /public/visit) : compteur agrégé jour × page × source
          (+ medium, campagne, navigateur intégré), sans cookie, sans IP ni identifiant (exemption
          CNIL) → indépendant du bandeau ;
       3) clic sur un lien /register → étape `cta_click` du parcours d'inscription
          (POST /public/funnel par sendBeacon, detail = data-cta, sinon plan du lien, sinon free).
       `inApp` = navigateur intégré Instagram / Facebook / TikTok (motif partagé @mtc/shared) : seul
       ce booléen part, jamais le user-agent.
       Mode interne : ?internal=1 (localStorage mtc_internal) → ni visite ni étape envoyée depuis ce
       navigateur, badge « interne » affiché ; ?internal=0 annule.
       Données fonctionnelles et anonymes : aucune dépendance au consentement GA4. -->
  <script is:inline define:vars={{ apiUrl: API_URL, inAppPattern: IN_APP_UA_PATTERN, internalKey: INTERNAL_STORAGE_KEY }}>
    (function () {
      try {
        // Mode interne (visites de l'équipe) : décidé avant tout envoi.
        var internal = false;
        try {
          var flag = new URL(window.location.href).searchParams.get('internal');
          if (flag === '1') localStorage.setItem(internalKey, '1');
          else if (flag === '0') localStorage.removeItem(internalKey);
          internal = localStorage.getItem(internalKey) === '1';
        } catch (e) {}
        if (internal) {
          var badge = document.createElement('div');
          badge.className = 'internal-badge';
          badge.textContent = 'interne';
          badge.title = 'Mode interne : visites et clics non comptés (?internal=0 pour annuler)';
          document.body.appendChild(badge);
        }
        var inApp = new RegExp(inAppPattern, 'i').test(navigator.userAgent || '');

        var KEY = 'mtc_utm', NAMES = ['utm_source', 'utm_medium', 'utm_campaign'];
        var params = new URL(window.location.href).searchParams, utm = {}, found = false;
        NAMES.forEach(function (n) {
          var v = (params.get(n) || '').trim().slice(0, 100);
          if (v) { utm[n] = v; found = true; }
        });
        if (!found) {
          try { utm = JSON.parse(sessionStorage.getItem(KEY) || '{}') || {}; } catch (e) { utm = {}; }
          found = NAMES.some(function (n) { return utm[n]; });
        }
        if (!found) {
          // Plan B : hôte du site d'origine, hors nos propres domaines (navigation interne).
          var host = '';
          try { host = document.referrer ? new URL(document.referrer).hostname.replace(/^www\./, '') : ''; } catch (e) {}
          if (host && !/(^|\.)mytradingcoach\.app$/.test(host) && host !== 'localhost') {
            utm = { utm_source: host.slice(0, 100), utm_medium: 'referral' };
            found = true;
          }
        }
        if (found) {
          try { sessionStorage.setItem(KEY, JSON.stringify(utm)); } catch (e) {}
          document.querySelectorAll('a[href*="/register"]').forEach(function (a) {
            try {
              var h = new URL(a.href);
              NAMES.forEach(function (n) {
                if (utm[n] && !h.searchParams.get(n)) h.searchParams.set(n, utm[n]);
              });
              a.href = h.toString();
            } catch (e) {}
          });
        }
        if (internal) return;

        var origin = {
          source: utm.utm_source || undefined,
          medium: utm.utm_medium || undefined,
          campaign: utm.utm_campaign || undefined,
          inApp: inApp
        };

        // Compteur de visite : 1re page de la session d'onglet = une visite.
        var entry = false;
        try { entry = !sessionStorage.getItem('mtc_visit'); sessionStorage.setItem('mtc_visit', '1'); } catch (e) {}
        fetch(apiUrl + '/public/visit', {
          method: 'POST',
          keepalive: true,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.assign({ path: location.pathname, entry: entry }, origin))
        }).catch(function () {});

        // Clic CTA d'inscription (délégation : couvre aussi la carte Fondateur insérée plus tard).
        // sendBeacon en text/plain : requête simple, part même quand la page change.
        document.addEventListener('click', function (ev) {
          var a = ev.target && ev.target.closest ? ev.target.closest('a[href*="/register"]') : null;
          if (!a) return;
          var cta = a.getAttribute('data-cta');
          if (!cta) {
            try { cta = new URL(a.href).searchParams.get('plan'); } catch (e) { cta = null; }
            if (cta !== 'founder' && cta !== 'premium') cta = 'free';
          }
          var body = JSON.stringify(Object.assign({ step: 'cta_click', detail: cta }, origin));
          var sent = false;
          try { sent = !!(navigator.sendBeacon && navigator.sendBeacon(apiUrl + '/public/funnel', new Blob([body], { type: 'text/plain' }))); } catch (e) {}
          if (!sent) {
            fetch(apiUrl + '/public/funnel', { method: 'POST', keepalive: true, headers: { 'Content-Type': 'text/plain' }, body: body }).catch(function () {});
          }
        }, true);
      } catch (e) {}
    })();
  </script>
</body>
</html>
