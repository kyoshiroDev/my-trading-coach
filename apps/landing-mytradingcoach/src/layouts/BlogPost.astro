---
import { APP_URL, FEATURES } from '../config';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ORGANIZATION, ORGANIZATION_REF, SITE, breadcrumb, faqPage } from '../data/schema';

export interface RelatedPost {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  tags?: string[];
  /** Nom du fichier de l'article : image de partage `/og/blog/<slug>.jpg`. */
  slug: string;
  /** Articles liés (calculés par `pages/blog/[slug].astro`). */
  related?: RelatedPost[];
  /** FAQ affichée en bas de l'article et reprise telle quelle dans le FAQPage. */
  faq?: { question: string; answer: string }[];
  /** Sources officielles des faits affirmés dans l'article. */
  sources?: { title: string; url: string; consulted: Date }[];
}

const { title, seoTitle, description, publishDate, updatedDate, tags = [], slug, related = [], faq = [], sources = [] } = Astro.props;
const frDate = (d: Date) => d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

// trailingSlash: 'never' → canonical sans slash de dossier (`/blog/x/` servi comme `/blog/x`).
const canonical = `${SITE}${Astro.url.pathname.replace(/(.)\/$/, '$1')}`;
const ogImage = `/og/blog/${slug}.jpg`;
const published = publishDate.toISOString();
const modified = updatedDate?.toISOString() ?? published;

// Fil d'Ariane : « Accueil » = /prop-firm, la page d'entrée (`/` y redirige en 302 depuis le
// 2026-11-08). Le fil visible et le BreadcrumbList ont les MÊMES étapes.
const crumbs = [
  { name: 'Accueil', url: `${SITE}/prop-firm` },
  { name: 'Blog', url: `${SITE}/blog` },
  { name: title, url: canonical },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "image": `${SITE}${ogImage}`,
    "inLanguage": "fr",
    "datePublished": published,
    "dateModified": modified,
    "author": ORGANIZATION_REF,
    "publisher": ORGANIZATION_REF,
    "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
    "url": canonical,
    ...(tags.length > 0 && { "keywords": tags.join(', ') }),
  },
  breadcrumb(crumbs),
  // FAQPage = la FAQ affichée en bas de l'article, mot pour mot.
  ...(faq.length > 0 ? [faqPage(faq)] : []),
  // Cible des références `@id` (auteur, éditeur) : présente sur la page même.
  ORGANIZATION,
];
---

<Base
  title={seoTitle ?? title}
  description={description}
  canonical={canonical}
  ogUrl={canonical}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={title}
  publishedTime={published}
  modifiedTime={modified}
  schema={schema}
>
  <Nav />

  <main class="article-wrap">
    <nav class="crumbs" aria-label="Fil d'Ariane">
      <ol>
        <li><a href="/prop-firm">Accueil</a></li>
        <li><a href="/blog">Blog</a></li>
        <li aria-current="page"><span class="crumb-current">{title}</span></li>
      </ol>
    </nav>

    <article>
      <header class="article-header">
        {tags.length > 0 && (
          <div class="article-tags">
            {tags.map(tag => (
              <span class="article-tag">{tag}</span>
            ))}
          </div>
        )}
        <h1 class="article-title">{title}</h1>
        <p class="article-date">
          Publié le {publishDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
          {updatedDate && ` · Mis à jour le ${updatedDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}`}
        </p>
      </header>

      <div class="prose">
        <slot />
      </div>

      {faq.length > 0 && (
        <section class="article-faq" aria-labelledby="faq-title">
          <h2 id="faq-title" class="related-title">Questions fréquentes</h2>
          {faq.map((f) => (
            <div class="faq-item">
              <h3 class="faq-q">{f.question}</h3>
              <p class="faq-a">{f.answer}</p>
            </div>
          ))}
        </section>
      )}

      {sources.length > 0 && (
        <section class="article-sources" aria-labelledby="sources-title">
          <h2 id="sources-title" class="related-title">Sources</h2>
          <ul class="sources-list">
            {sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener" target="_blank">{s.title}</a>
                <span class="source-date"> · consulté le {frDate(s.consulted)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {related.length > 0 && (
        <aside class="article-related" aria-labelledby="related-title">
          <h2 id="related-title" class="related-title">À lire aussi</h2>
          <ul class="related-list">
            {related.map((r) => (
              <li><a href={`/blog/${r.slug}`}>{r.title}</a></li>
            ))}
            {FEATURES.multiAccounts && (
              <li><a href="/journal-trading-prop-firm">Le journal de trading prop firm et multi-comptes</a></li>
            )}
          </ul>
        </aside>
      )}

      <div class="article-cta">
        <p>Prêt à améliorer ton trading ?</p>
        <p class="article-cta-sub">Rejoins les traders qui utilisent MyTradingCoach pour identifier leurs patterns.</p>
        <a href={`${APP_URL}/register`} class="article-cta-btn">
          Essayer gratuitement →
        </a>
      </div>
    </article>
  </main>

  <Footer />
</Base>

<style>
  .article-wrap {
    max-width: 800px;
    margin: 0 auto;
    padding: 60px 40px;
  }

  @media (min-width: 1200px) {
    .article-wrap {
      max-width: 860px;
      padding: 60px 0;
    }
  }

  @media (max-width: 768px) {
    .article-wrap {
      padding: 40px 20px;
    }
  }

  /* ── Fil d'Ariane (mêmes étapes que le BreadcrumbList) ── */
  .crumbs {
    margin-bottom: 2rem;
    font-size: 0.875rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--txt3);
  }

  .crumbs li {
    display: inline-flex;
    gap: 6px;
    min-width: 0;
  }

  .crumbs li + li::before {
    content: '›'; /* repli : navigateur sans texte alternatif de content */
    content: '›' / '';
    color: var(--txt3);
  }

  .crumbs a {
    color: var(--txt2);
    text-decoration: none;
    transition: color 0.2s;
  }

  .crumbs a:hover,
  .crumbs a:focus-visible {
    color: var(--txt);
    text-decoration: underline;
  }

  /* Titre de l'article dans le fil : une ligne terminée par « … » (jamais de défilement horizontal).
     L'ellipse se pose sur le texte (span), pas sur le li en inline-flex. */
  .crumbs li[aria-current] {
    max-width: 100%;
  }

  .crumb-current {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── Article header ── */
  .article-header {
    margin-bottom: 2.5rem;
  }

  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .article-tag {
    background: color-mix(in srgb, var(--blue) 10%, transparent);
    color: var(--blue2);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-family: var(--mono);
  }

  .article-title {
    font-family: var(--disp);
    font-size: 42px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.5px;
    color: var(--txt);
    margin-bottom: 12px;
  }

  @media (max-width: 768px) {
    .article-title {
      font-size: 28px;
    }
  }

  .article-date {
    color: var(--txt2);
    font-size: 0.875rem;
    font-family: var(--mono);
  }

  /* ── FAQ et sources ── */
  .article-faq,
  .article-sources {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--b);
  }

  .faq-item + .faq-item {
    margin-top: 1.25rem;
  }

  .faq-q {
    font-family: var(--disp);
    font-size: 17px;
    font-weight: 600;
    color: var(--txt);
    margin: 0 0 0.4rem;
  }

  .faq-a {
    font-size: 15px;
    line-height: 1.75;
    color: var(--txt2);
    margin: 0;
  }

  .sources-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    line-height: 1.6;
  }

  .sources-list a {
    color: var(--blue2);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .source-date {
    color: var(--txt3);
    font-family: var(--mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  /* ── Articles liés ── */
  .article-related {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--b);
  }

  .related-title {
    font-family: var(--disp);
    font-size: 20px;
    font-weight: 700;
    color: var(--txt);
    margin: 0 0 1rem;
  }

  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .related-list a {
    color: var(--blue2);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 15px;
    line-height: 1.5;
  }

  .related-list a:hover {
    color: var(--txt);
  }

  /* ── CTA ── */
  .article-cta {
    margin-top: 3rem;
    padding: 2rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--blue) 10%, transparent), color-mix(in srgb, var(--pulse) 5%, transparent));
    border: 1px solid var(--b2);
    border-radius: 1rem;
    text-align: center;
  }

  .article-cta p {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--txt);
  }

  .article-cta-sub {
    color: var(--txt2);
    font-size: 0.875rem !important;
    font-weight: 400 !important;
    margin: 0 0 1.5rem !important;
  }

  .article-cta-btn {
    display: inline-block;
    background: var(--blue); /* comme les autres CTA ; le cyan est réservé au direct et à l'IA (#1084) */
    color: var(--on-blue);
    padding: 0.75rem 2rem;
    border-radius: 0.5rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s;
  }

  .article-cta-btn:hover {
    background: var(--blue2);
  }

</style>

<!-- is:global requis : le slot injecte des éléments depuis un scope Astro différent -->
<style is:global>
  .prose {
    color: var(--txt2);
    line-height: 1.85;
    font-size: 16px;
  }

  .prose h1 {
    font-family: var(--disp);
    font-size: 28px;
    font-weight: 700;
    color: var(--txt);
    margin: 32px 0 14px;
    letter-spacing: -0.3px;
  }

  .prose h2 {
    font-family: var(--disp);
    font-size: 24px;
    font-weight: 700;
    color: var(--txt);
    margin: 28px 0 10px;
  }

  .prose h3 {
    font-family: var(--disp);
    font-size: 19px;
    font-weight: 600;
    color: var(--txt);
    margin: 20px 0 8px;
  }

  .prose p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--txt2);
    margin-bottom: 16px;
  }

  .prose strong {
    color: var(--txt);
    font-weight: 600;
  }

  .prose ul,
  .prose ol {
    padding-left: 22px;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .prose li {
    font-size: 15px;
    line-height: 1.7;
    color: var(--txt2);
  }

  .prose a {
    color: var(--blue2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose a:visited {
    color: var(--blue2);
  }

  .prose blockquote {
    border-left: 3px solid var(--blue);
    padding: 12px 20px;
    background: var(--bg2);
    border-radius: 0 8px 8px 0;
    margin: 20px 0;
    color: var(--txt2);
    font-style: italic;
  }

  .prose code {
    font-family: var(--mono);
    font-size: 13px;
    background: var(--bg2);
    border: 1px solid var(--b);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--blue2);
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--b);
    margin: 32px 0;
  }
</style>
