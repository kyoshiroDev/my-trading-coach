# ─── Utilisé par le container API dans docker-compose.local.yml ───────────────
# Copier vers .env.local et remplir les vraies valeurs
# Les hostnames sont les noms des containers Docker (réseau interne mtc_local)

# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mtc_user:devpassword@mtc_pgbouncer_local:5432/mytradingcoach?pgbouncer=true&connection_limit=1
DATABASE_DIRECT_URL=postgresql://mtc_user:devpassword@mtc_postgres_local:5432/mytradingcoach
POSTGRES_USER=mtc_user
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=mytradingcoach

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_64_chars_random_string_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_64_chars_different_string_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=15m

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:devredispass@mtc_redis_local:6379
REDIS_PASSWORD=devredispass

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Active les appels au modèle Anthropic. Mettre "false" hors production (Dev/CI) pour zéro dépense.
AI_ENABLED=false

# ─── Mail (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
MAIL_FROM=noreply@mytradingcoach.app
MAIL_SAV=support@mytradingcoach.app

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_BOT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ROLE_MEMBRE_ID=
DISCORD_ROLE_PREMIUM_ID=
DISCORD_INVITE_LINK=https://discord.gg/zSPD9pv4eB

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200
# ─── Tradovate / NinjaTrader (PROMPT-207, synchro API lecture seule) ──────────
# OAuth : identifiants de l'inscription OAuth MTC (≠ clé API perso). Sans ces 3 variables
# + la clé de chiffrement, la connexion Tradovate est désactivée proprement (503 clair).
TRADOVATE_OAUTH_CLIENT_ID=
TRADOVATE_OAUTH_CLIENT_SECRET=
# Doit être EXACTEMENT l'URL enregistrée côté Tradovate (servie hors /api) :
#   beta : https://beta.api.mytradingcoach.app/integrations/tradovate/callback
#   prod : https://api.mytradingcoach.app/integrations/tradovate/callback
TRADOVATE_OAUTH_REDIRECT_URI=
# Chiffrement AES-256-GCM des tokens broker en base : `openssl rand -base64 32`.
# Ne JAMAIS la changer sans prévoir la reconnexion des users (tokens illisibles).
BROKER_TOKEN_ENCRYPTION_KEY=
# Clé API perso (auth directe, tests de Greg uniquement) : NON utilisée par le flux OAuth.
TRADOVATE_API_NAME=
TRADOVATE_API_PASSWORD=
TRADOVATE_API_CID=
TRADOVATE_API_SECRET=
