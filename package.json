{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "postinstall": "echo skip prisma generate",
    "clean": "rm -rf .angular/cache .nx/cache",
    "dev": "rm -rf .angular/cache && nx serve app-mytradingcoach",
    "dev:api": "NODE_ENV=development nx serve api-mytradingcoach",
    "dev:admin": "nx serve admin-mytradingcoach",
    "dev:landing": "nx dev landing-mytradingcoach",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "e2e": "nx run-many -t e2e",
    "affected": "nx affected -t lint typecheck test build",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:generate": "prisma generate --config=./prisma/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config=./prisma/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config=./prisma/prisma.config.ts",
    "db:reset": "prisma migrate reset --config=./prisma/prisma.config.ts",
    "db:studio": "prisma studio --config=./prisma/prisma.config.ts",
    "seed:demo": "tsx --env-file-if-exists=apps/api-mytradingcoach/.env --tsconfig tools/scripts/tsconfig.check.json tools/scripts/seed/demo-account.ts",
    "seed:user": "tsx --env-file-if-exists=apps/api-mytradingcoach/.env --tsconfig tools/scripts/tsconfig.check.json tools/scripts/seed/user-account.ts"
  },
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=11.6.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.4",
