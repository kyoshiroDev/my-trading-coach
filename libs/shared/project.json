{
  "name": "shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/src",
  "projectType": "library",
  "tags": [
    "type:lib",
    "scope:shared"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default"
      ],
      "options": {
        "command": "vitest run --config vitest.config.mts",
        "cwd": "libs/shared"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default"
      ],
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "libs/shared"
      }
    }
  }
}
