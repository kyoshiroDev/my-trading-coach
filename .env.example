# ════════════════════════════════════════════════════════════════════
#  MyTradingCoach — API NestJS — exemple d'environnement (dev local)
#  Copier en `.env` à la RACINE du dépôt : `cp .env.example .env`.
#  ⚠️ Placeholders uniquement, ne jamais commiter de vraie valeur.
#
#  Qui lit ce fichier ?
#   • `pnpm dev:api` (Nx) charge `.env` dans l'environnement du process API.
#   • Prisma (`prisma.config.ts`) le lit via dotenv pour migrate / studio.
#   • `docker compose up -d` lit POSTGRES_* pour créer la base locale.
#  Les variables marquées [CRITIQUE] sont vérifiées au démarrage (main.ts) :
#  l'API refuse de démarrer si l'une manque.
# ════════════════════════════════════════════════════════════════════

# ─── Base de données ───────────────────────────────────────────────────────────
# `docker compose up -d postgres redis` (docker-compose.yml) expose postgres sur :5432.
# En local, pas de pgbouncer : DATABASE_URL et DATABASE_DIRECT_URL pointent sur postgres.
# En prod, DATABASE_URL passe par pgbouncer (`?pgbouncer=true&connection_limit=1`).
DATABASE_URL=postgresql://mtc_user:devpassword@localhost:5432/mytradingcoach     # [CRITIQUE]
DATABASE_DIRECT_URL=postgresql://mtc_user:devpassword@localhost:5432/mytradingcoach
POSTGRES_USER=mtc_user
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=mytradingcoach

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_64_chars_random_string_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx          # [CRITIQUE]
JWT_REFRESH_SECRET=change_me_64_chars_different_string_xxxxxxxxxxxxxxxxxxxxxxxxxxxx      # [CRITIQUE]
# Durées des tokens : fixées dans le code (auth.module.ts / auth.service.ts), pas en variable.

# ─── Redis (cache + BullMQ) ──────────────────────────────────────────────────────
# Le code lit REDIS_HOST (défaut: localhost) et REDIS_PORT. En PROD, REDIS_HOST est
# OBLIGATOIRE (nom du service réseau), sinon connexion sur localhost = échec.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=devredispass      # identique à `--requirepass` du docker-compose.yml

# ─── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...                                                            # [CRITIQUE]
# Active les appels au modèle Anthropic. Mettre "false" hors production (Dev/CI) pour zéro dépense.
AI_ENABLED=true
# Hors prod, le débrief IA renvoie un texte factice. `true` force le vrai appel en dev.
# AI_DEBRIEF_DEV=false
# Clé Admin org Anthropic (sk-ant-admin01-…), lecture usage/cost — BACKEND UNIQUEMENT.
# Alimente l'écran admin « Usage IA » avec le coût RÉEL facturé (Cost API). Nécessite une
# organisation Anthropic (pas un compte individuel). Jamais côté client ni dans le bundle.
ANTHROPIC_ADMIN_KEY=

# ─── Mail (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...                                                                   # [CRITIQUE]
MAIL_FROM=noreply@mytradingcoach.app
MAIL_SAV=support@mytradingcoach.app

# ─── Stripe ──────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...                                                           # [CRITIQUE]
STRIPE_WEBHOOK_SECRET=whsec_...                                                         # [CRITIQUE]
# Premium en _V2 (migration de prix : les anciens IDs non-V2 ne sont plus utilisés)
STRIPE_PREMIUM_PRICE_MONTHLY_V2=price_...                                               # [CRITIQUE]
STRIPE_PREMIUM_PRICE_YEARLY_V2=price_...                                                # [CRITIQUE]
# STRIPE_PUBLIC_KEY=pk_test_... # Frontend uniquement — non utilisé par NestJS

# ─── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_BOT_SECRET=
DISCORD_GUILD_ID=
DISCORD_ROLE_MEMBRE_ID=
DISCORD_ROLE_PREMIUM_ID=
# DISCORD_CLIENT_ID : lu uniquement par scripts/discord-bot/register-commands.mjs

# ─── FMP — Financial Modeling Prep (calendrier éco + news + recherche actifs) ──
# Plan Starter requis — https://site.financialmodelingprep.com/pricing-plans
FMP_API_KEY=

# ─── App / runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development          # 'production' active l'IA (eco/import) ; sinon coupée
PORT=3000
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://localhost:4321
IS_CRON_WORKER=false          # opt-in : true UNIQUEMENT sur le worker/instance cron. Absent ou false = AUCUN cron (fail-safe cluster). En prod clusterise (NODE_ENV=production) main.ts en designe deja un seul.
NEWS_TRANSLATION=true         # traduction IA des news (Premium)
API_URL=http://localhost:3000 # URL publique de l'API (liens de désinscription dans les emails)
MARKETING_COOLDOWN_DAYS=4     # jours minimum entre deux emails marketing à un même user

# ─── Tradovate (connexion broker OAuth) ─────────────────────────────────────────
# Sans ces 4 variables, la connexion Tradovate est simplement désactivée.
TRADOVATE_OAUTH_CLIENT_ID=
TRADOVATE_OAUTH_CLIENT_SECRET=
TRADOVATE_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/tradovate/callback
# Clé AES-256 (32 octets en base64) qui chiffre les tokens broker en base.
# Générer : `openssl rand -base64 32`. La perdre oblige les users à reconnecter Tradovate.
BROKER_TOKEN_ENCRYPTION_KEY=

# ─── Optionnels / contexte ───────────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/yyy
# PUPPETEER_EXECUTABLE_PATH=  # chemin Chromium pour l'export PDF (selon l'image Docker)
# BACKUP_DIR=/opt/backups     # répertoire des backups BDD (module admin/vps)

# ─── VPS (module admin : déploiement / backups via SSH) ──────────────────────────
# VPS_HOST=
# VPS_USER=
# VPS_SSH_KEY_B64=            # clé SSH privée encodée en base64
